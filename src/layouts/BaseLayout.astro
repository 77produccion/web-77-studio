---
// src/layouts/BaseLayout.astro
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileStickyBar from '@/components/MobileStickyBar.astro';
import AIChatWidget from '@/components/chat/AIChatWidget.astro';
import WhatsAppFloating from '@/components/WhatsAppFloating.astro';
import { DEFAULT_SEO } from '@/utils/seo';
import type { WhatsAppContext } from '@/utils/whatsapp';
import type { SupportedLocale } from '@/lib/i18n/ui';
import { getLangFromUrl, getAlternateLocaleUrl } from '@/lib/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  whatsappContext?: WhatsAppContext;
  lang?: SupportedLocale;
  heroImage?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideMobileBar?: boolean;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || getLangFromUrl(Astro.url)) as SupportedLocale;

const {
  title = DEFAULT_SEO.title,
  description = DEFAULT_SEO.description,
  canonical = Astro.url.href,
  ogImage = DEFAULT_SEO.ogImage,
  whatsappContext = 'home',
  hideNav = false,
  hideFooter = false,
  hideMobileBar = true,
  heroImage,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteBaseUrl = Astro.site ? Astro.site.origin : 'https://77studio.co';
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBaseUrl).href;
const esUrl = new URL(getAlternateLocaleUrl(Astro.url, 'es'), siteBaseUrl).href;
const enUrl = new URL(getAlternateLocaleUrl(Astro.url, 'en'), siteBaseUrl).href;
const esUrl = new URL(getAlternateLocaleUrl(Astro.url, 'es'), Astro.site || Astro.url.origin).href;
const enUrl = new URL(getAlternateLocaleUrl(Astro.url, 'en'), Astro.site || Astro.url.origin).href;
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-M6NH5PGW';
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/77studio.webp" />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang SEO multi-idioma -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- DNS Prefetch & Preconnect for External Resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- LCP Hero Image Preload for Instant First Paint -->
    <link rel="preload" as="image" href={heroImage || "/images/opai-img-300.webp"} type="image/webp" fetchpriority="high" />

    <!-- Google Fonts: Sora, Inter Tight, IBM Plex Mono, Poppins (Non-blocking async load) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=Poppins:wght@700;800;900&family=Sora:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=Poppins:wght@700;800;900&family=Sora:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=Poppins:wght@700;800;900&family=Sora:wght@400;500;600;700;800&display=swap"
      />
    </noscript>

    <!-- Google Tag Manager & Analytics DataLayer Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:site_name" content="77 Studio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD Structured Data for Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "77 Studio",
      "image": "https://77studio.co/img/openGraph/og-image.png",
      "url": "https://77studio.co",
      "telephone": "+573148490955",
      "priceRange": "$$",
      "address": [
        {
          "@type": "PostalAddress",
          "addressLocality": "Armenia",
          "addressCountry": "CO"
        },
        {
          "@type": "PostalAddress",
          "addressLocality": "Miami",
          "addressCountry": "US"
        }
      ],
      "description": currentLang === 'en' 
        ? "Digital Studio + Creative Partner + Technology & AI Company in Colombia and the United States."
        : "Digital Studio + Creative Partner + Technology & AI Company en Colombia y Estados Unidos.",
      "sameAs": [
        "https://www.instagram.com/77studio",
        "https://www.linkedin.com/company/77studio"
      ]
    })} />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 text-background-13 antialiased selection:bg-opai-purple selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        aria-hidden="true"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    {!hideNav && <Header currentPath={currentPath} whatsappContext={whatsappContext} lang={currentLang} />}

    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer lang={currentLang} />}

    {!hideMobileBar && <MobileStickyBar whatsappContext={whatsappContext} lang={currentLang} />}

    <!-- Botón Flotante de WhatsApp con Tracking Avanzado (Joinchat Specs) - Lado Inferior Izquierdo -->
    <WhatsAppFloating whatsappContext={whatsappContext} lang={currentLang} />

    <!-- Asesora Comercial Flotante con IA (Sofía - 77 Studio) - Lado Inferior Derecho -->
    <AIChatWidget whatsappContext={whatsappContext} lang={currentLang} />

    <!-- 77 Studio Client-Side Animation Engine -->
    <script src="@/scripts/animations.ts"></script>

    <!-- 77 Studio Analytics Event Bus (sin PII) -->
    <script src="@/scripts/tracking.ts"></script>
  </body>
</html>
