---
// src/layouts/BaseLayout.astro
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileStickyBar from '@/components/MobileStickyBar.astro';
import AIChatWidget from '@/components/chat/AIChatWidget.astro';
import WhatsAppFloating from '@/components/WhatsAppFloating.astro';
import { DEFAULT_SEO, buildStructuredData, directoryPath, toPublicUrl } from '@/utils/seo';
import { alternatePathMap } from '@/utils/public-routes';
import type { WhatsAppContext } from '@/utils/whatsapp';
import type { SupportedLocale } from '@/lib/i18n/ui';
import { getLangFromUrl } from '@/lib/i18n/utils';

interface HeroPreload {
  href: string;
  srcset?: string;
  sizes?: string;
  type?: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  whatsappContext?: WhatsAppContext;
  lang?: SupportedLocale;
  heroImage?: string;
  heroPreload?: HeroPreload;
  breadcrumbLabel?: string;
  /** Migas explícitas (nombre + ruta). Si vienen, reemplazan las automáticas. */
  breadcrumbTrail?: { name: string; path: string }[];
  /** @id de la entidad principal de esta URL (un Service local, por ejemplo). */
  mainEntityId?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideMobileBar?: boolean;
  noindex?: boolean;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || getLangFromUrl(Astro.url)) as SupportedLocale;

const {
  title = DEFAULT_SEO.title,
  description = DEFAULT_SEO.description,
  ogImage = DEFAULT_SEO.ogImage,
  ogType = 'website',
  whatsappContext = 'home',
  hideNav = false,
  hideFooter = false,
  hideMobileBar = true,
  heroImage,
  heroPreload,
  breadcrumbLabel,
  breadcrumbTrail,
  mainEntityId,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
const site = Astro.site ?? new URL('https://www.77studio.co');
const canonicalUrl = toPublicUrl(site, directoryPath(Astro.url.pathname));
const resolvedOgImage = ogImage
  ? toPublicUrl(site, ogImage)
  : toPublicUrl(site, DEFAULT_SEO.ogImage ?? '/img/openGraph/og-image.png');
const alternates = alternatePathMap(Astro.url.pathname);
const esUrl = alternates.es ? toPublicUrl(site, alternates.es) : undefined;
const enUrl = alternates.en ? toPublicUrl(site, alternates.en) : undefined;
const xDefaultUrl = esUrl ?? enUrl;
const imagePreload = heroPreload ?? (heroImage ? { href: heroImage, type: 'image/webp' } : undefined);
const ogImageType = resolvedOgImage.endsWith('.webp')
  ? 'image/webp'
  : resolvedOgImage.endsWith('.jpg') || resolvedOgImage.endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';
const structuredData = JSON.stringify(buildStructuredData({
  site,
  canonical: canonicalUrl,
  pathname: directoryPath(Astro.url.pathname),
  lang: currentLang,
  title,
  description,
  noindex,
  breadcrumbLabel,
  breadcrumbTrail,
  mainEntityId,
})).replace(/</g, '\\u003c');
const gtmId = import.meta.env.PUBLIC_GTM_ID || 'GTM-M6NH5PGW';
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <!--
      Google Tag Manager se carga después del load (o al primer gesto) para no competir con el LCP.
      dataLayer sigue recibiendo eventos antes: GTM los procesa al arrancar.
    -->
    <script is:inline define:vars={{ gtmId }}>
      window.dataLayer = window.dataLayer || [];
      (function () {
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        }
        function schedule() {
          if ('requestIdleCallback' in window) requestIdleCallback(loadGtm, { timeout: 2000 });
          else setTimeout(loadGtm, 1);
        }
        function arm() {
          setTimeout(schedule, 1200);
        }
        if (document.readyState === 'complete') arm();
        else window.addEventListener('load', arm);
        ['pointerdown', 'keydown', 'touchstart'].forEach(function (eventName) {
          window.addEventListener(eventName, schedule, { once: true, passive: true });
        });
      })();
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="kuBqafhHLCare1JW_D2JEEbT5_DBAWgaF-wnG4qadkI" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Hreflang solo hacia URLs que el build realmente genera -->
    {!noindex && esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Sora es la fuente del H1. Swap en @font-face: el texto pinta con la de sistema y luego cambia. -->
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />

    {imagePreload && (
      <link
        rel="preload"
        as="image"
        href={imagePreload.href}
        imagesrcset={imagePreload.srcset}
        imagesizes={imagePreload.sizes}
        type={imagePreload.type || 'image/webp'}
        fetchpriority="high"
      />
    )}

    <!--
      Crítico e independiente del CSS grande: en móvil la decoración del hero no puede ser el LCP,
      y el titular no puede quedar en opacity 0 hasta que corra el JS.
    -->
    <style>
      @font-face {
        font-family: Sora;
        font-style: normal;
        font-weight: 600 700;
        font-display: optional;
        src: url("/fonts/sora-latin.woff2") format("woff2");
      }
      html, body { background: #f9fafb; color: #0a0a0a; }
      body { margin: 0; font-family: "Inter Tight", system-ui, sans-serif; }
      h1 { font-family: Sora, system-ui, sans-serif; font-size: 2.25rem; font-weight: 700; line-height: 1.12; letter-spacing: -0.025em; }
      .hero-static,
      .hero-static [data-text-reveal],
      .hero-static [data-opai-animate] {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
      @media (max-width: 639px) {
        .hero-deco { display: none !important; }
      }
    </style>

    <!-- Google Tag Manager & Analytics DataLayer Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:site_name" content="77 Studio" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD: Organization, ProfessionalService, WebSite y migas -->
    <script type="application/ld+json" set:html={structuredData} />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 text-background-13 antialiased selection:bg-opai-purple selection:text-white">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        aria-hidden="true"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    {isHome && !hideNav && (
      <div data-beasties-container>
        <Header currentPath={currentPath} whatsappContext={whatsappContext} lang={currentLang} />
      </div>
    )}
    {!isHome && !hideNav && <Header currentPath={currentPath} whatsappContext={whatsappContext} lang={currentLang} />}

    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer lang={currentLang} />}

    {!hideMobileBar && <MobileStickyBar whatsappContext={whatsappContext} lang={currentLang} />}

    <!-- Botón Flotante de WhatsApp con Tracking Avanzado (Joinchat Specs) - Lado Inferior Izquierdo -->
    <WhatsAppFloating whatsappContext={whatsappContext} lang={currentLang} />

    <!-- Asesora Comercial Flotante con IA (Sofía - 77 Studio) - Lado Inferior Derecho -->
    <AIChatWidget whatsappContext={whatsappContext} lang={currentLang} />

    <!-- 77 Studio Client-Side Animation Engine -->
    <script src="@/scripts/animations.ts"></script>

    <!-- 77 Studio Analytics Event Bus (sin PII) -->
    <script src="@/scripts/tracking.ts"></script>
  </body>
</html>
