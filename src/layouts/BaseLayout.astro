---
// src/layouts/BaseLayout.astro
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileStickyBar from '@/components/MobileStickyBar.astro';
import AIChatWidget from '@/components/chat/AIChatWidget.astro';
import WhatsAppFloating from '@/components/WhatsAppFloating.astro';
import { DEFAULT_SEO } from '@/utils/seo';
import type { WhatsAppContext } from '@/utils/whatsapp';
import type { SupportedLocale } from '@/lib/i18n/ui';
import { getLangFromUrl, getAlternateLocaleUrl } from '@/lib/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  whatsappContext?: WhatsAppContext;
  lang?: SupportedLocale;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideMobileBar?: boolean;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || getLangFromUrl(Astro.url)) as SupportedLocale;

const {
  title = DEFAULT_SEO.title,
  description = DEFAULT_SEO.description,
  canonical = Astro.url.href,
  ogImage = DEFAULT_SEO.ogImage,
  whatsappContext = 'home',
  hideNav = false,
  hideFooter = false,
  hideMobileBar = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const esUrl = new URL(getAlternateLocaleUrl(Astro.url, 'es'), Astro.site || Astro.url.origin).href;
const enUrl = new URL(getAlternateLocaleUrl(Astro.url, 'en'), Astro.site || Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/77studio.webp" />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang SEO multi-idioma -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Google Fonts: Sora, Inter Tight, IBM Plex Mono, Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter+Tight:wght@300;400;500;600;700&family=Poppins:wght@700;800;900&family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Tag Manager & Analytics DataLayer Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'es_CO'} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data for Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "77 Studio",
      "image": "https://77.studio/img/77studio.png",
      "url": "https://77.studio",
      "telephone": "+573148490955",
      "priceRange": "$$",
      "address": [
        {
          "@type": "PostalAddress",
          "addressLocality": "Armenia",
          "addressCountry": "CO"
        },
        {
          "@type": "PostalAddress",
          "addressLocality": "Miami",
          "addressCountry": "US"
        }
      ],
      "description": currentLang === 'en' 
        ? "Digital Studio + Creative Partner + Technology & AI Company in Colombia and the United States."
        : "Digital Studio + Creative Partner + Technology & AI Company en Colombia y Estados Unidos.",
      "sameAs": [
        "https://www.instagram.com/77studio",
        "https://www.linkedin.com/company/77studio"
      ]
    })} />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 text-background-13 antialiased selection:bg-opai-purple selection:text-white">
    
    {!hideNav && <Header currentPath={currentPath} whatsappContext={whatsappContext} lang={currentLang} />}

    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer lang={currentLang} />}

    {!hideMobileBar && <MobileStickyBar whatsappContext={whatsappContext} lang={currentLang} />}

    <!-- Botón Flotante de WhatsApp con Tracking Avanzado (Joinchat Specs) - Lado Inferior Izquierdo -->
    <WhatsAppFloating whatsappContext={whatsappContext} lang={currentLang} />

    <!-- Asesora Comercial Flotante con IA (Sofía - 77 Studio) - Lado Inferior Derecho -->
    <AIChatWidget whatsappContext={whatsappContext} lang={currentLang} />

    <!-- 77 Studio Client-Side Animation Engine -->
    <script src="@/scripts/animations.ts"></script>
  </body>
</html>
