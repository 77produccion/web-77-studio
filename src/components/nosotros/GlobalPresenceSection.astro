---
// src/components/nosotros/GlobalPresenceSection.astro
import { MapPin, ExternalLink } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';
---

<section class="py-20 sm:py-28 bg-slate-50 border-t border-black/5 relative overflow-hidden">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">

    <!-- 2-Column Section: Left Contact & Location Card + Right Google Maps View -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch mb-14 max-w-6xl mx-auto">
      
      <!-- LEFT: 77 Studio Contact, Branding & Location Information (Light Theme) -->
      <div 
        data-opai-animate 
        data-delay="0.1" 
        class="lg:col-span-7 rounded-[28px] border border-stroke-2/60 bg-white p-7 sm:p-9 lg:p-10 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <!-- Logo 77 Studio (negro3.png) -->
          <div class="mb-5">
            <img 
              src="/img/logo-variaciones/negro3.webp" 
              alt="77 Studio Marketing" 
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Section Title & Narrative -->
          <h2 data-text-reveal class="font-sora text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-background-13 leading-tight mb-3">
            {isEn ? "Architected to operate beyond geographical borders." : "Pensados para trabajar más allá de una ubicación."}
          </h2>

          <p class="font-inter-tight text-sm sm:text-base text-background-13/75 leading-relaxed mb-8">
            {isEn
              ? "Our cross-border remote structure bridges tier-one technical talent in Colombia with enterprises in the United States, Latin America, and global markets."
              : "Nuestra estructura remota e internacional conecta el mejor talento de Colombia con empresas en Estados Unidos, Latinoamérica y mercados globales."}
          </p>

          <!-- 2 Regional Phone Cards (Colombia & United States) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            
            <!-- Colombia Hub -->
            <div class="group/item flex flex-col justify-between p-4.5 rounded-2xl bg-slate-50 border border-black/8 hover:border-black/20 hover:bg-white hover:shadow-xs transition-all duration-200">
              <div class="flex items-center gap-2 mb-2">
                <img 
                  src="/img/svg/flag-for-flag-colombia-svgrepo-com.svg" 
                  alt="Bandera Colombia" 
                  class="w-5 h-5 object-contain"
                />
                <span class="font-ibm-plex-mono text-xs font-semibold text-background-13/75 uppercase tracking-wider">
                  Colombia
                </span>
              </div>

              <a 
                href="https://api.whatsapp.com/send?phone=573148490955&text=Hola%2077%20Studio%20%F0%9F%91%8B%20Quisiera%20conversar%20sobre%20un%20proyecto." 
                target="_blank" 
                rel="noopener noreferrer"
                class="font-sora text-base sm:text-lg font-bold text-background-13 group-hover/item:text-opai-purple transition-colors tracking-tight mt-1"
              >
                +57 3148490955
              </a>
            </div>

            <!-- United States Hub -->
            <div class="group/item flex flex-col justify-between p-4.5 rounded-2xl bg-slate-50 border border-black/8 hover:border-black/20 hover:bg-white hover:shadow-xs transition-all duration-200">
              <div class="flex items-center gap-2 mb-2">
                <img 
                  src="/img/svg/flag-for-flag-united-states-svgrepo-com.svg" 
                  alt="Bandera Estados Unidos" 
                  class="w-5 h-5 object-contain"
                />
                <span class="font-ibm-plex-mono text-xs font-semibold text-background-13/75 uppercase tracking-wider">
                  United States
                </span>
              </div>

              <a 
                href="tel:+12029337792" 
                class="font-sora text-base sm:text-lg font-bold text-background-13 group-hover/item:text-opai-purple transition-colors tracking-tight mt-1"
              >
                +1 (202) 933 7792
              </a>
            </div>

          </div>

          <!-- Email Card -->
          <div class="group/email flex flex-col p-4.5 rounded-2xl bg-slate-50 border border-black/8 hover:border-black/20 hover:bg-white hover:shadow-xs transition-all duration-200">
            <span class="font-ibm-plex-mono text-xs text-background-13/60 font-semibold block mb-0.5">
              {isEn ? "Email" : "Email de contacto"}
            </span>
            <a 
              href="mailto:gerencia@77studio.co" 
              class="font-sora text-base sm:text-lg font-bold text-background-13 group-hover/email:text-opai-purple transition-colors tracking-tight"
            >
              gerencia@77studio.co
            </a>
          </div>

        </div>
      </div>

      <!-- RIGHT: Interactive Google Maps Component -->
      <div 
        data-opai-animate 
        data-delay="0.2" 
        class="lg:col-span-5 relative rounded-[28px] overflow-hidden border border-stroke-2/60 bg-white shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col min-h-[380px] sm:min-h-[440px]"
      >
        <!-- Floating "Abrir en Maps" Button -->
        <a 
          href="https://maps.app.goo.gl/Bc1xPC6tbrNHMNzk7" 
          target="_blank" 
          rel="noopener noreferrer"
          class="absolute top-4 left-4 z-10 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/95 backdrop-blur-md border border-black/10 text-xs font-semibold text-background-13 hover:bg-opai-purple hover:text-white shadow-md transition-all duration-300 group/btn"
        >
          <span>{isEn ? "Open in Maps" : "Abrir en Maps"}</span>
          <ExternalLink class="size-3.5 group-hover/btn:translate-x-0.5 transition-transform" />
        </a>

        <!-- Interactive Google Map Embed -->
        <div class="relative w-full flex-1 min-h-[320px] bg-slate-100">
          <iframe 
            src="https://maps.google.com/maps?q=77+Studio+SAS,+Armenia,+Quindio&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            class="absolute inset-0 w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade" 
            title="77 Studio Google Maps"
          ></iframe>
        </div>

        <!-- Bottom Location Footer Bar -->
        <div class="p-4 bg-white border-t border-black/8 flex items-center justify-between gap-3 text-xs font-ibm-plex-mono text-background-13/75">
          <div class="flex items-center gap-2 truncate">
            <MapPin class="size-3.5 text-opai-purple shrink-0" />
            <span class="truncate">Armenia, Quindío · Colombia ↔ USA</span>
          </div>
          <span class="text-emerald-600 font-semibold shrink-0">Presencial & Remoto</span>
        </div>
      </div>

    </div>

    <!-- Sleek Live Callout Banner (Matching Sofía / Live Assistance Banner Style) -->
    <div 
      data-opai-animate 
      data-delay="0.3"
      class="rounded-3xl bg-white/90 border border-stroke-2/60 p-6 sm:p-8 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] hover:shadow-md transition-all duration-300 max-w-6xl mx-auto"
    >
      <div class="flex items-center gap-4 text-left">
        <!-- Avatar with Live Indicator -->
        <div class="relative size-12 sm:size-13 shrink-0 rounded-2xl overflow-hidden border border-opai-purple/20 shadow-xs bg-slate-50">
          <img 
            src="/img/sofIA/profile-sofia-pic.webp" 
            alt="77 Studio Partner" 
            class="size-full object-cover" 
            onerror="this.src='/img/77studio.webp'" 
          />
          <span class="absolute bottom-0.5 right-0.5 size-3 rounded-full bg-emerald-500 border-2 border-white"></span>
        </div>

        <!-- Text Hierarchy -->
        <div>
          <span class="inline-block font-ibm-plex-mono text-[11px] font-semibold text-opai-purple uppercase tracking-wider mb-0.5">
            {isEn ? "Direct Advisory & Growth" : "Asistencia & Colaboración Directa"}
          </span>
          <h4 class="font-sora text-base sm:text-lg font-bold text-background-13">
            {isEn
              ? "Want to see how we can partner with your enterprise?"
              : "¿Quieres conocer cómo podemos colaborar con tu empresa?"}
          </h4>
          <p class="font-inter-tight text-xs sm:text-sm text-background-13/65">
            {isEn
              ? "We operate seamlessly across industries and time zones. Let's discuss your roadmap."
              : "Trabajamos sin fronteras con equipos en diferentes industrias y husos horarios. Hablemos de tus planes."}
          </p>
        </div>
      </div>

      <!-- Action Button -->
      <div class="shrink-0 flex items-center gap-3 w-full sm:w-auto">
        <a
          href="https://api.whatsapp.com/send?phone=573148490955&text=Hola%2077%20Studio%20%F0%9F%91%8B%20Quisiera%20conversar%20sobre%20un%20proyecto%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto font-ibm-plex-mono text-xs sm:text-sm font-semibold text-white bg-background-13 hover:bg-opai-purple px-6 py-3.5 rounded-xl transition-all duration-300 shadow-sm hover:shadow-md cursor-pointer flex items-center justify-center gap-2.5 group"
        >
          <span>💬</span>
          <span>{isEn ? "Talk with our team" : "Hablar con el equipo"}</span>
        </a>
      </div>
    </div>

  </div>
</section>
