---
// src/components/not-found/NotFoundHero.astro
import { getNotFoundTranslations } from '@/lib/i18n/pages/not-found';
import { getWhatsAppUrl } from '@/utils/whatsapp';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getNotFoundTranslations(currentLang);
const homeUrl = currentLang === 'en' ? '/en' : '/';
const whatsappUrl = getWhatsAppUrl('notFound', undefined, currentLang);
---

<section class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 overflow-hidden">
  <!-- Subtle Background Gradients -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-60">
    <div class="h-[550px] w-[550px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[140px]"></div>
    <div class="h-[450px] w-[450px] rounded-full bg-gradient-to-bl from-blue-400/10 to-transparent blur-[120px] -translate-y-24"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Massive 404 Stylized Display -->
      <div data-opai-animate data-delay="0.1" class="relative my-2 select-none">
        <span class="font-sora text-7xl sm:text-9xl lg:text-[140px] font-black tracking-tighter bg-gradient-to-b from-background-13/90 via-background-13/50 to-opai-purple/30 bg-clip-text text-transparent leading-none">
          {t.code}
        </span>
      </div>

      <!-- Headline -->
      <h1 data-text-reveal data-delay="0.2" class="font-sora text-3xl sm:text-5xl lg:text-[52px] font-bold tracking-tight text-background-13 leading-[1.15] mb-6">
        {t.headline}<span class="font-serif italic text-opai-purple">{t.headlineHighlight}</span>
      </h1>

      <!-- Subheadline -->
      <p data-opai-animate data-delay="0.3" class="font-inter-tight text-base sm:text-lg lg:text-xl text-background-13/70 max-w-2xl mx-auto mb-10 leading-relaxed">
        {t.subheadline}
      </p>

      <!-- Action Buttons (Dual Recovery Pattern) -->
      <div data-opai-animate data-delay="0.4" class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        
        <!-- Primary Pill Button: Return Home -->
        <a href={homeUrl} class="w-full sm:w-auto inline-block">
          <div class="bg-background-4 group button font-ibm-plex-mono text-tagline-2 text-background-11 flex h-13 w-full sm:w-auto items-center rounded-2xl p-1 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.15)] hover:shadow-[0_6px_25px_-4px_rgba(141,89,255,0.3)] transition-all duration-300">
            <div class="button-icon relative z-20 h-11 w-14 overflow-hidden rounded-[13px]">
              <div class="bg-opai-purple flex size-full items-center justify-center shadow-[inset_0_3px_10px_rgba(255,255,255,0.4)]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5 fill-white">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
              </div>
            </div>
            <span class="button-text shrink-0 px-5 font-semibold">{t.homeCta}</span>
          </div>
        </a>

        <!-- Secondary WhatsApp Support Button -->
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-block">
          <div class="bg-white hover:bg-emerald-50 border border-emerald-500/20 group font-ibm-plex-mono text-tagline-2 text-emerald-700 flex h-13 w-full sm:w-auto items-center justify-center rounded-2xl px-6 transition-all duration-300 shadow-[0_2px_10px_rgba(0,0,0,0.03)] hover:border-emerald-500/40">
            <span class="flex items-center gap-2 font-medium">
              <svg class="size-4.5 fill-emerald-600" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/></svg>
              {t.whatsappCta}
            </span>
          </div>
        </a>

      </div>

    </div>

    <!-- Quick Navigation Recovery Grid (CRO Optimization) -->
    <div class="mt-8 pt-10 border-t border-black/5">
      <div class="text-center mb-8">
        <h2 class="font-ibm-plex-mono text-xs sm:text-sm font-semibold uppercase tracking-widest text-background-13/60">
          {t.quickLinksTitle}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {t.services.map((item, idx) => (
          <a
            href={item.href}
            data-opai-animate
            data-delay={`${0.2 + idx * 0.1}`}
            class="group relative flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white p-6 sm:p-7 border border-stroke-2/60 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_30px_-8px_rgba(141,89,255,0.12)] hover:border-opai-purple/40 hover:-translate-y-1 transition-all duration-300"
          >
            <div>
              <!-- Service Icon Box -->
              <div class="mb-5 flex size-12 items-center justify-center rounded-2xl bg-background-8 text-background-13 group-hover:bg-opai-purple group-hover:text-white transition-colors duration-300">
                {item.icon === 'marketing' && (
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 11 18-5v12L3 14v-3z"/>
                    <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
                  </svg>
                )}
                {item.icon === 'web' && (
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2"/>
                    <path d="m9 10 2 2-2 2"/>
                    <path d="m13 14 2-2-2-2"/>
                  </svg>
                )}
                {item.icon === 'ia' && (
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                  </svg>
                )}
                {item.icon === 'productos' && (
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                )}
              </div>

              <!-- Title & Desc -->
              <h3 class="font-sora text-lg font-bold text-background-13 group-hover:text-opai-purple transition-colors duration-300 mb-2">
                {item.title}
              </h3>
              <p class="font-inter-tight text-xs sm:text-sm text-background-13/60 leading-relaxed">
                {item.desc}
              </p>
            </div>

            <!-- Card Bottom Action Indicator -->
            <div class="mt-6 flex items-center justify-between pt-4 border-t border-black/5 text-xs font-ibm-plex-mono font-medium text-background-13/50 group-hover:text-opai-purple transition-colors">
              <span>{currentLang === 'en' ? 'Explore service' : 'Explorar servicio'}</span>
              <span class="transform group-hover:translate-x-1 transition-transform duration-300 font-bold">➔</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Live Assistance Callout Card -->
      <div data-opai-animate data-delay="0.6" class="mt-8 rounded-3xl bg-white/70 border border-stroke-2/60 p-6 sm:p-8 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-6 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)]">
        <div class="flex items-center gap-4 text-left">
          <div class="relative size-12 shrink-0 rounded-2xl overflow-hidden border border-opai-purple/20 shadow-sm">
            <img src="/img/sofIA/profile-sofia-pic.webp" alt="Sofía 77 Studio" class="size-full object-cover" onerror="this.src='/img/77studio.webp'" / loading="lazy" decoding="async" />
            <span class="absolute bottom-0.5 right-0.5 size-3 rounded-full bg-emerald-500 border-2 border-white"></span>
          </div>
          <div>
            <span class="inline-block font-ibm-plex-mono text-[11px] font-semibold text-opai-purple uppercase tracking-wider">
              {t.helpBox.badge}
            </span>
            <h4 class="font-sora text-base font-bold text-background-13">
              {t.helpBox.title}
            </h4>
            <p class="font-inter-tight text-xs sm:text-sm text-background-13/60">
              {t.helpBox.desc}
            </p>
          </div>
        </div>

        <button
          type="button"
          onclick="if(window.open77Chat){window.open77Chat();}else{document.getElementById('chatTriggerBtn')?.click();}"
          class="shrink-0 font-ibm-plex-mono text-xs sm:text-sm font-semibold text-white bg-background-13 hover:bg-opai-purple px-5 py-3 rounded-xl transition-all duration-300 shadow-sm hover:shadow-md cursor-pointer flex items-center gap-2"
        >
          <span>💬</span>
          <span>{currentLang === 'en' ? 'Open Sofia Chat' : 'Hablar con Sofía'}</span>
        </button>
      </div>

    </div>

  </div>
</section>
