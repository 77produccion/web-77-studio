---
// src/components/home/EcosystemSection.astro
import { getHomeTranslations } from '@/lib/i18n/pages/home';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getHomeTranslations(currentLang);
const langPrefix = currentLang === 'en' ? '/en' : '';

const pillars = currentLang === 'en' ? [
  {
    id: "marketing",
    name: "Marketing & Growth",
    subtitle: "Acquisition & Brand",
    description: "We connect commercial strategy, Meta and Google Ads, visual creativity, and content production to generate qualified pipeline.",
    items: [
      "High-ROI Meta Ads & Google Ads campaigns",
      "Video production, ad creative, and social content",
      "Visual identity design and persuasive copywriting"
    ],
    href: `${langPrefix}/marketing`
  },
  {
    id: "web",
    name: "Web Development & CRO",
    subtitle: "Conversion & Speed",
    description: "We design and build ultra-fast websites and landing pages engineered as conversion machines that establish immediate trust.",
    items: [
      "Modern architecture for sub-second page loads",
      "Dual commercial conversion (WhatsApp & Email)",
      "Technical SEO and 100% responsive fluid design"
    ],
    href: `${langPrefix}/web`
  },
  {
    id: "ia",
    name: "AI + Automation",
    subtitle: "Efficiency & Workflows",
    description: "We streamline commercial follow-ups, customer inquiry triage, and daily operations through automated CRM workflows.",
    items: [
      "Instant routing and qualification for inbound leads",
      "Intelligent AI query agents with custom knowledge",
      "API integrations, webhooks, and multi-system flows"
    ],
    href: `${langPrefix}/ia-automatizacion`
  },
  {
    id: "productos",
    name: "Digital Products & SaaS",
    subtitle: "Software & Scale",
    description: "We build custom software products, SaaS platforms, client portals, agile MVPs, and operational dashboards.",
    items: [
      "Agile MVP development to validate business models",
      "Interactive customer portals and admin dashboards",
      "Scalable and secure cloud-native infrastructure"
    ],
    href: `${langPrefix}/productos-digitales`
  }
] : [
  {
    id: "marketing",
    name: "Marketing Digital & Ads",
    subtitle: "Adquisición & Marca",
    description: "Conectamos estrategia comercial, anuncios en Meta y Google, creatividad visual y producción de contenido para generar demanda calificada.",
    items: [
      "Campañas Meta Ads & Google Ads de alto ROI",
      "Producción de video, piezas y contenido para redes",
      "Diseño de identidad visual y copywriting persuasivo"
    ],
    href: "/marketing"
  },
  {
    id: "web",
    name: "Desarrollo Web & Landings",
    subtitle: "Conversión & Arquitectura",
    description: "Diseñamos y desarrollamos sitios web y landing pages ultra-rápidas, estructuradas como máquinas de conversión y confianza.",
    items: [
      "Islands Architecture para carga en menos de 1 segundo",
      "Doble canal de conversión (WhatsApp & Formulario)",
      "SEO técnico avanzado y diseño 100% responsivo"
    ],
    href: "/web"
  },
  {
    id: "ia",
    name: "IA + Automatización",
    subtitle: "Eficiencia & Flujos",
    description: "Optimizamos el seguimiento comercial, la atención y la gestión operativa diaria mediante flujos automáticos y CRM.",
    items: [
      "Enrutamiento y respuesta instantánea a leads comerciales",
      "Agentes de consulta inteligentes con bases de conocimiento",
      "Conexión de sistemas mediante Make y APIs a la medida"
    ],
    href: "/ia-automatizacion"
  },
  {
    id: "productos",
    name: "Productos Digitales & SaaS",
    subtitle: "Software & Escala",
    description: "Construimos herramientas digitales, plataformas SaaS, portales para clientes, MVPs ágiles y dashboards de control.",
    items: [
      "Desarrollo ágil de MVPs para validar modelos de negocio",
      "Portales web interactivos y paneles de administración",
      "Infraestructura escalable y segura en la nube"
    ],
    href: "/productos-digitales"
  }
];
---

<section
  data-opai-animate
  data-delay="0.1"
  class="bg-[url('/images/opai-35.webp')] bg-cover bg-center bg-no-repeat py-20 sm:py-28 relative overflow-hidden"
  aria-labelledby="ecosystem-heading"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
    
    <!-- Section Header (Centered on Dark Background with Enhanced Text Contrast) -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 id="ecosystem-heading" data-text-reveal class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight drop-shadow-[0_2px_8px_rgba(0,0,0,0.35)]">
        {t.ecosystem.title}
      </h2>
      <p class="font-inter-tight text-base sm:text-lg text-white/90 font-medium leading-relaxed max-w-2xl mx-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.25)]">
        {t.ecosystem.description}
      </p>
    </div>

    <!-- 4 Staggered vertical capability cards in a grid (Image 3 / Pricing inspired style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-14">
      {pillars.map((pillar, index) => (
        <div
          data-opai-animate
          data-delay={(index + 1) * 0.15}
          class="group flex flex-col justify-between rounded-3xl bg-white p-6 sm:p-8 xl:p-9 shadow-lg border border-black/5 hover:shadow-2xl hover:scale-[1.035] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-opai-purple/20 card-hover min-h-[500px] h-full"
        >
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="font-ibm-plex-mono text-[10px] text-background-13/50 uppercase tracking-wider">
                {pillar.subtitle}
              </span>
            </div>

            <h3 class="font-sora text-xl sm:text-2xl font-bold text-background-13 mb-4 group-hover:text-opai-purple transition-colors">
              {pillar.name}
            </h3>

            <p class="font-inter-tight text-xs sm:text-sm text-background-13/70 leading-relaxed mb-6">
              {pillar.description}
            </p>

            <ul class="space-y-3" aria-label={`Características de ${pillar.name}`}>
              {pillar.items.map((item) => (
                <li class="flex items-start justify-start gap-x-2.5 text-xs sm:text-sm text-background-13/75 font-inter-tight leading-relaxed">
                  <span class="mt-1 shrink-0 text-opai-purple" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="9" viewBox="0 0 13 9" fill="none" class="w-3.5 h-3.5 fill-current">
                      <path d="M12.354 0.854028L4.35403 8.85403C4.30759 8.90052 4.25245 8.9374 4.19175 8.96256C4.13105 8.98772 4.06599 9.00067 4.00028 9.00067C3.93457 9.00067 3.86951 8.98772 3.80881 8.96256C3.74811 8.9374 3.69296 8.90052 3.64653 8.85403L0.146528 5.35403C0.0527077 5.26021 0 5.13296 0 5.00028C0 4.8676 0.0527077 4.74035 0.146528 4.64653C0.240348 4.55271 0.367596 4.5 0.500278 4.5C0.63296 4.5 0.760208 4.55271 0.854028 4.64653L4.00028 7.7934L11.6465 0.146528C11.7403 0.0527074 11.8676 -9.88557e-10 12.0003 0C12.133 9.88558e-10 12.2602 0.0527074 12.354 0.146528C12.4478 0.240348 12.5006 0.367596 12.5006 0.500278C12.5006 0.63296 12.4478 0.760208 12.354 0.854028Z" />
                    </svg>
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Slide Pill Button at bottom -->
          <div class="w-full mt-6">
            <a href={pillar.href} class="w-full inline-block">
              <div class="bg-background-4 group button font-ibm-plex-mono text-xs text-background-11 flex h-[50px] w-full items-center rounded-2xl p-1 cursor-pointer">
                <!-- Icon Wrapper -->
                <div class="button-icon relative z-20 h-10 w-13 overflow-hidden rounded-xl flex items-center justify-center">
                  <div class="bg-opai-purple absolute inset-0 z-20 flex size-full items-center justify-center shadow-[inset_0_3px_10px_rgba(255,255,255,0.4)]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" class="w-3.5 h-3.5 fill-white/80" aria-hidden="true">
                      <path d="M6 0H8V2H6V0Z M0 0H2V2H0V0Z M9 3H11V5H9V3Z M3 3H5V5H3V3Z M12 6H14V8H12V6Z M6 6H8V8H6V6Z M9 9H11V11H9V9Z M3 9H5V11H3V9Z M6 12H8V14H6V12Z M0 12H2V14H0V12Z" />
                    </svg>
                  </div>
                </div>
                <!-- Text -->
                <span class="button-text shrink-0 font-medium px-4">{currentLang === 'en' ? 'Explore' : 'Explorar'} {pillar.name.split(' ')[0]}</span>
              </div>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
