---
// src/components/home/ProcessSection.astro
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const steps = isEn ? [
  {
    step: "01",
    name: "Discover",
    title: "Diagnosis & Objectives",
    description: "We analyze your business model, current bottlenecks, audience, and priority goals before recommending any tech or creative solution."
  },
  {
    step: "02",
    name: "Strategize",
    title: "Roadmap & Scope",
    description: "We design a transparent action plan: concrete deliverables, realistic timelines, and the required marketing or software stack."
  },
  {
    step: "03",
    name: "Build & Ship",
    title: "Agile Execution",
    description: "We develop your ad campaigns, web platform, automated workflows, or custom software with world-class aesthetic and functional standards."
  },
  {
    step: "04",
    name: "Scale & Optimize",
    title: "Measurement & Growth",
    description: "We monitor performance against core business metrics and continuously refine to maximize return on investment and operational leverage."
  }
] : [
  {
    step: "01",
    name: "Entendemos",
    title: "Diagnóstico & Objetivo",
    description: "Analizamos tu modelo de negocio, cuellos de botella actuales, audiencia y objetivos prioritarios antes de proponer cualquier solución técnica o creativa."
  },
  {
    step: "02",
    name: "Proponemos",
    title: "Estrategia & Alcance",
    description: "Diseñamos un plan de acción claro y transparente: entregables concretos, tiempos realistas y la arquitectura de marketing o tecnología requerida."
  },
  {
    step: "03",
    name: "Creamos",
    title: "Ejecución Ágil",
    description: "Desarrollamos tus campañas, plataforma web, flujos de automatización o software con los más altos estándares de calidad estética y funcional."
  },
  {
    step: "04",
    name: "Optimizamos",
    title: "Medición & Escala",
    description: "Monitoreamos el rendimiento con métricas reales de negocio y ajustamos continuamente para maximizar el retorno de inversión y la eficiencia operativa."
  }
];

const title = isEn
  ? "A structured 4-step process engineered for guaranteed results."
  : "Un proceso estructurado en 4 pasos para garantizar resultados.";

const subtitle = isEn
  ? "Zero friction, zero unnecessary bureaucracy. Direct communication, iterative deliveries, and an unwavering focus on revenue growth."
  : "Sin fricción ni burocracia innecesaria. Comunicación directa, entregas iterativas y enfoque permanente en mover la aguja comercial.";
---

<section id="proceso" class="py-20 sm:py-28 bg-slate-50/30 relative overflow-hidden">
  <!-- Background Photographic Image with Higher Visibility -->
  <img 
    src="/img/bgs/Sala-de-juntas.webp" 
    alt="77 Studio Sala de Juntas" 
    loading="lazy" 
    decoding="async" 
    class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none opacity-40 mix-blend-multiply"
  />
  <div class="absolute inset-0 bg-slate-50/20 pointer-events-none" />

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6 relative z-10">
    
    <!-- 1. DESKTOP VIEW: High-End Orbital Curve Timeline (md and up) -->
    <div 
      class="process-orbital-container relative w-full max-w-5xl mx-auto min-h-[520px] select-none hidden md:flex flex-col items-center justify-between py-2"
      data-steps={JSON.stringify(steps)}
    >
      <!-- Background Thin Gradient Arc (Encloses Header and Card with Zero Overlap) -->
      <svg viewBox="0 0 1000 450" class="w-full h-full absolute inset-0 pointer-events-none z-0" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="orbitalArcGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.2" />
            <stop offset="50%" stop-color="#7c3aed" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <path 
          d="M 60 135 C 180 410, 820 410, 940 135" 
          stroke="url(#orbitalArcGrad)" 
          stroke-width="3" 
          stroke-dasharray="6 6"
          class="opacity-90"
        />
      </svg>

      <!-- Center Header Content (Enclosed inside the Upper Arc) -->
      <div class="text-center max-w-3xl mx-auto pt-2 pb-4 relative z-10 space-y-3">
        <h2 class="font-sora text-3xl lg:text-4xl xl:text-5xl font-extrabold tracking-tight text-background-13 leading-tight">
          {title}
        </h2>
        <p class="font-inter-tight text-base lg:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
          {subtitle}
        </p>
      </div>

      <!-- Interactive Step Node Buttons (Positioned Horizontally Outside the Card Area to Prevent Any Overlap) -->
      <!-- Node 01 (Far Upper Left) -->
      <button
        class="process-node absolute flex items-center justify-center rounded-full size-12 lg:size-14 bg-white text-background-13 font-ibm-plex-mono font-bold text-sm lg:text-base border border-black/10 shadow-sm transition-all duration-300 cursor-pointer z-20 hover:scale-110"
        style="left: 6%; top: 30%; transform: translate(-50%, -50%);"
        data-step="0"
        aria-label={`Step 01: ${steps[0].name}`}
      >
        01
      </button>

      <!-- Node 02 (Lower Left - Outside Card Boundary) -->
      <button
        class="process-node absolute flex items-center justify-center rounded-full size-12 lg:size-14 bg-white text-background-13 font-ibm-plex-mono font-bold text-sm lg:text-base border border-black/10 shadow-sm transition-all duration-300 cursor-pointer z-20 hover:scale-110"
        style="left: 18%; top: 68%; transform: translate(-50%, -50%);"
        data-step="1"
        aria-label={`Step 02: ${steps[1].name}`}
      >
        02
      </button>

      <!-- Node 03 (Lower Right - Outside Card Boundary) -->
      <button
        class="process-node absolute flex items-center justify-center rounded-full size-12 lg:size-14 bg-white text-background-13 font-ibm-plex-mono font-bold text-sm lg:text-base border border-black/10 shadow-sm transition-all duration-300 cursor-pointer z-20 hover:scale-110"
        style="left: 82%; top: 68%; transform: translate(-50%, -50%);"
        data-step="2"
        aria-label={`Step 03: ${steps[2].name}`}
      >
        03
      </button>

      <!-- Node 04 (Far Upper Right) -->
      <button
        class="process-node absolute flex items-center justify-center rounded-full size-12 lg:size-14 bg-white text-background-13 font-ibm-plex-mono font-bold text-sm lg:text-base border border-black/10 shadow-sm transition-all duration-300 cursor-pointer z-20 hover:scale-110"
        style="left: 94%; top: 30%; transform: translate(-50%, -50%);"
        data-step="3"
        aria-label={`Step 04: ${steps[3].name}`}
      >
        04
      </button>

      <!-- Bottom Center Elevated Active Step Card (Cleanly Centered between Nodes 02 & 03 with Ample Clearance) -->
      <div class="relative z-10 w-full max-w-md mx-auto bg-white/95 backdrop-blur-md rounded-2xl p-6 lg:p-7 border border-black/10 shadow-xl text-center space-y-2.5 mb-2 transform transition-all duration-300">
        <h3 class="process-step-title font-sora text-2xl lg:text-3xl font-bold text-background-13 tracking-tight">
          {steps[0].name}
        </h3>

        <p class="process-step-subtitle font-sora text-xs sm:text-sm font-semibold text-background-13/50 tracking-wide uppercase">
          {steps[0].title}
        </p>

        <p class="process-step-description font-inter-tight text-sm lg:text-base text-background-13/80 leading-relaxed max-w-sm mx-auto pt-1">
          {steps[0].description}
        </p>

        <!-- Progress Dots Indicator -->
        <div class="flex items-center justify-center gap-2 pt-2">
          {steps.map((_, idx) => (
            <span class={`process-dot h-1.5 rounded-full transition-all duration-300 ${idx === 0 ? 'w-6 bg-opai-purple' : 'w-1.5 bg-black/15'}`} />
          ))}
        </div>
      </div>
    </div>

    <!-- 2. MOBILE VIEW: 4 Clean, Beautiful Cards Grid (under md) -->
    <div class="space-y-6 md:hidden">
      <!-- Mobile Header -->
      <div class="text-center max-w-xl mx-auto space-y-3 mb-8">
        <h2 class="font-sora text-2xl sm:text-3xl font-extrabold text-background-13 tracking-tight leading-tight">
          {title}
        </h2>
        <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Mobile 4 Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {steps.map((st) => (
          <div class="rounded-2xl border border-black/10 bg-white p-6 shadow-xs flex flex-col justify-between space-y-2">
            <div>
              <h3 class="font-sora text-xl font-bold text-background-13 mb-1">
                {st.name}
              </h3>

              <p class="font-sora text-xs font-semibold text-background-13/50 tracking-wide uppercase mb-3">
                {st.title}
              </p>

              <p class="font-inter-tight text-sm text-background-13/75 leading-relaxed">
                {st.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* Smooth transitions for active step content */
  .process-step-title,
  .process-step-subtitle,
  .process-step-description {
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Style for Active Node Button on desktop */
  .process-node.active-node {
    background-color: var(--color-opai-purple, #7c3aed) !important;
    color: #ffffff !important;
    border-color: #ffffff !important;
    transform: translate(-50%, -50%) scale(1.25) !important;
    box-shadow: 0 0 0 6px rgba(124, 58, 237, 0.2), 0 10px 25px rgba(124, 58, 237, 0.25) !important;
  }
</style>

<script>
  function initProcessOrbital() {
    const container = document.querySelector('.process-orbital-container');
    if (!container) return;

    const dataAttr = container.getAttribute('data-steps');
    if (!dataAttr) return;

    const steps = JSON.parse(dataAttr);
    const nodes = container.querySelectorAll('.process-node');
    const titleEl = container.querySelector('.process-step-title') as HTMLElement;
    const subtitleEl = container.querySelector('.process-step-subtitle') as HTMLElement;
    const descEl = container.querySelector('.process-step-description') as HTMLElement;
    const dots = container.querySelectorAll('.process-dot');

    if (!titleEl || !descEl) return;

    let currentIndex = 0;
    let timerId: any = null;

    const updateStep = (index: number) => {
      // 1. Update node buttons active state
      nodes.forEach((node, idx) => {
        if (idx === index) {
          node.classList.add('active-node');
        } else {
          node.classList.remove('active-node');
        }
      });

      // 2. Update progress dots
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.className = 'process-dot h-1.5 rounded-full transition-all duration-300 w-6 bg-opai-purple';
        } else {
          dot.className = 'process-dot h-1.5 rounded-full transition-all duration-300 w-1.5 bg-black/15';
        }
      });

      // 3. Fade out active card text
      const textEls = [titleEl, subtitleEl, descEl];
      textEls.forEach(el => {
        if (el) {
          el.style.opacity = '0';
          el.style.transform = 'translateY(6px)';
        }
      });

      // 4. Update content and fade back in
      setTimeout(() => {
        const stepData = steps[index];
        if (titleEl) titleEl.textContent = stepData.name;
        if (subtitleEl) subtitleEl.textContent = stepData.title;
        if (descEl) descEl.textContent = stepData.description;

        textEls.forEach(el => {
          if (el) {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }
        });
      }, 200);

      currentIndex = index;
    };

    const startTimer = () => {
      timerId = setInterval(() => {
        const nextIndex = (currentIndex + 1) % steps.length;
        updateStep(nextIndex);
      }, 5000);
    };

    const resetTimer = () => {
      if (timerId) {
        clearInterval(timerId);
      }
      startTimer();
    };

    // Bind click handlers to nodes
    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        const stepIdx = parseInt(node.getAttribute('data-step') || '0', 10);
        if (stepIdx === currentIndex) return;
        updateStep(stepIdx);
        resetTimer();
      });
    });

    // Initialize initial state
    updateStep(0);
    startTimer();
  }

  // Bind to lifecycle
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessOrbital);
  } else {
    initProcessOrbital();
  }
  document.addEventListener('astro:page-load', initProcessOrbital);
</script>
