---
// src/components/home/SolutionsGrid.astro
const solutions = [
  {
    title: "Marketing Digital & Ads",
    badge: "Adquisición & Marca",
    description: "Conectamos estrategia comercial, anuncios en Meta y Google, creatividad visual y producción de contenido con IA para atraer atención y generar demanda calificada.",
    points: ["Campañas Meta Ads & Google Ads de alto ROI", "Producción de video, piezas y contenido para redes", "Diseño de identidad visual y copywriting persuasivo"],
    href: "/marketing/",
    cta: "Explorar Marketing",
    gradient: "from-purple-500/10 via-transparent to-transparent"
  },
  {
    title: "Desarrollo Web & Landings",
    badge: "Conversión & Arquitectura",
    description: "Diseñamos y desarrollamos sitios web y landing pages ultra-rápidas con Astro y Tailwind CSS, estructuradas como máquinas de conversión y confianza comercial.",
    points: ["Islands Architecture para carga < 1 segundo", "Doble CTA de conversión (WhatsApp + Form)", "SEO técnico estricto y diseño 100% responsivo"],
    href: "/web/",
    cta: "Explorar Web",
    gradient: "from-blue-500/10 via-transparent to-transparent"
  },
  {
    title: "IA + Automatización de Procesos",
    badge: "Eficiencia & Flujos",
    description: "Optimizamos el seguimiento comercial, la atención al cliente y las operaciones diarias mediante agentes de IA y flujos automáticos en CRM y plataformas cloud.",
    points: ["Enrutamiento y respuesta instantánea a leads", "Agentes de consulta inteligentes con RAG", "Conexión de sistemas mediante Make, n8n y APIs"],
    href: "/ia-automatizacion/",
    cta: "Explorar IA + Automatización",
    gradient: "from-emerald-500/10 via-transparent to-transparent"
  },
  {
    title: "Productos Digitales & SaaS",
    badge: "Software & Escala",
    description: "Construimos herramientas a medida, plataformas SaaS, MVPs para validar modelos de negocio, portales para clientes y dashboards analíticos en tiempo real.",
    points: ["Desarrollo ágil de MVPs funcionales", "Portales web y paneles de control interactivos", "Arquitectura escalable en la nube (Dokploy / Vercel)"],
    href: "/productos-digitales/",
    cta: "Explorar Productos Digitales",
    gradient: "from-amber-500/10 via-transparent to-transparent"
  }
];
---

<section class="py-20 sm:py-28 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3.5 py-1 font-ibm-plex-mono text-xs text-opai-purple mb-4">
          <span>SERVICIOS INTEGRADOS</span>
        </div>
        <h2 class="font-sora text-3xl sm:text-5xl font-bold tracking-tight text-background-13 leading-tight">
          Cuatro capacidades. Un mismo objetivo: hacer crecer tu empresa.
        </h2>
      </div>
      <p class="font-inter-tight text-sm sm:text-base text-background-13/70 max-w-sm">
        Cada servicio puede contratarse de forma independiente o integrarse como un sistema completo de crecimiento.
      </p>
    </div>

    <!-- 4 Major Capability Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {solutions.map((sol) => (
        <div class="group relative rounded-[24px] border border-black/10 bg-white p-8 sm:p-10 shadow-xs card-hover flex flex-col justify-between overflow-hidden">
          
          <!-- Subtle corner gradient -->
          <div class={`pointer-events-none absolute top-0 right-0 h-44 w-44 rounded-full bg-gradient-to-bl ${sol.gradient} blur-2xl transition-opacity group-hover:opacity-100 opacity-50`}></div>

          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="font-ibm-plex-mono text-xs font-semibold text-opai-purple bg-opai-purple/10 px-3 py-1 rounded-lg">
                {sol.badge}
              </span>
            </div>

            <h3 class="font-sora text-2xl sm:text-3xl font-bold text-background-13 mb-4 group-hover:text-opai-purple transition-colors">
              {sol.title}
            </h3>

            <p class="font-inter-tight text-base text-background-13/75 leading-relaxed mb-6">
              {sol.description}
            </p>

            <div class="space-y-2.5 mb-8">
              {sol.points.map((pt) => (
                <div class="flex items-center gap-2.5 text-sm font-inter-tight text-background-13/80">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-opai-purple font-bold text-xs">
                    ✓
                  </span>
                  <span>{pt}</span>
                </div>
              ))}
            </div>
          </div>

          <a
            href={sol.href}
            class="inline-flex items-center justify-between rounded-xl bg-slate-50 border border-black/5 px-5 py-3.5 font-ibm-plex-mono text-xs font-semibold text-background-13 hover:bg-background-13 hover:text-white transition-all group-hover:border-black/20"
          >
            <span>{sol.cta}</span>
            <span>→</span>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>
