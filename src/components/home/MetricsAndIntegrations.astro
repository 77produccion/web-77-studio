const platforms = [
  { name: "Meta", src: "/img/logos-platforms/logotipo-empresa-meta_265339-667.avif", tooltip: "Meta Business Partner" },
  { name: "Google", src: "/img/logos-platforms/Google_Favicon_2025.svg.webp", tooltip: "Google Ads Premier Partner" },
  { name: "WhatsApp", src: "/img/logos-platforms/whatsapp.webp", tooltip: "WhatsApp" },
  { name: "OpenAI", src: "/img/logos-platforms/openai.svg", tooltip: "OpenAI" },
  { name: "Claude", src: "/img/logos-platforms/claude.webp", tooltip: "Claude" },
  { name: "Gemini AI", src: "/img/logos-platforms/gemini AI.webp", tooltip: "Gemini AI" },
  { name: "React", src: "/img/logos-platforms/react-logo.webp", tooltip: "Desarrollo" },
  { name: "Astro", src: "/img/logos-platforms/astro.webp", tooltip: "Astro" },
  { name: "Vercel", src: "/img/logos-platforms/vercel.svg", tooltip: "Vercel" },
  { name: "Supabase", src: "/img/logos-platforms/supabase.webp", tooltip: "Supabase" },
  { name: "Make", src: "/img/logos-platforms/gmdiaTTz.webp", tooltip: "Make Automation Expert" },
  { name: "Zapier", src: "/img/logos-platforms/zapier.webp", tooltip: "Zapier Certified Systems" },
  { name: "HubSpot", src: "/img/logos-platforms/hubspot_logo_orange.webp", tooltip: "HubSpot CRM Integration" },
  { name: "Odoo", src: "/img/logos-platforms/odoo.webp", tooltip: "Odoo" },
  { name: "Kapso", src: "/img/logos-platforms/kapso.webp", tooltip: "Kapso", customClass: "rounded-md" },
