  },
  {
    value: "< 45s",
    label: "Commercial Response Time",
    desc: "24/7 instant attention on WhatsApp",
    auraGradient: "radial-gradient(circle at center, rgba(16,185,129,0.3) 0%, rgba(124,58,237,0.15) 60%, transparent 100%)"
  },
  {
    value: "-42%",
    label: "Average CAC Reduction",
    desc: "Continuous ad & conversion optimization",
    auraGradient: "radial-gradient(circle at center, rgba(245,158,11,0.3) 0%, rgba(236,72,153,0.15) 60%, transparent 100%)"
  },
  {
    value: "100%",
    label: "Transparent ROI Attribution",
    desc: "Unified tracking from click to payment",
    auraGradient: "radial-gradient(circle at center, rgba(59,130,246,0.3) 0%, rgba(124,58,237,0.15) 60%, transparent 100%)"
  }
] : [
  {
    value: "+310%",
    label: "Incremento en Leads Calificados",
    desc: "Filtro de IA pre-califica antes de agendar",
    auraGradient: "radial-gradient(circle at center, rgba(124,58,237,0.3) 0%, rgba(59,130,246,0.15) 60%, transparent 100%)"
  },
  {
    value: "< 45s",
    label: "Tiempo de Respuesta Comercial",
    desc: "Atención 24/7 sin demora en WhatsApp",
    auraGradient: "radial-gradient(circle at center, rgba(16,185,129,0.3) 0%, rgba(124,58,237,0.15) 60%, transparent 100%)"
  },
  {
    value: "-42%",
    label: "Reducción del CAC Promedio",
    desc: "Optimización continua de pauta & conversión",
    auraGradient: "radial-gradient(circle at center, rgba(245,158,11,0.3) 0%, rgba(236,72,153,0.15) 60%, transparent 100%)"
  },
