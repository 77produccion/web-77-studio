---
// src/components/home/InternationalPresence.astro
import { getHomeTranslations } from '@/lib/i18n/pages/home';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getHomeTranslations(currentLang);
---

<section class="relative py-20 sm:py-28 overflow-hidden bg-background-13">
  <!-- Background Image with Dark Overlay - Full Cover -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <img
      src="/img/banner-usa-col.webp"
      alt="Presencia y Cobertura Global Colombia y Estados Unidos"
      class="w-full h-full object-cover object-center opacity-50"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/70 backdrop-blur-[1px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1290px] px-4 sm:px-6">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <span class="inline-block font-ibm-plex-mono text-xs font-semibold text-white/60 uppercase tracking-widest">
        {t.international.badge}
      </span>

      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-[40px] font-extrabold tracking-tight text-white leading-[1.2] uppercase">
        {t.international.title}
      </h2>

      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-sm sm:text-base md:text-lg text-white/80 max-w-3xl mx-auto leading-relaxed">
        {t.international.description}
      </p>

    </div>
  </div>
</section>
