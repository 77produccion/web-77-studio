---
// src/components/home/TestimonialsSection.astro
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const titleMain = isEn ? "What Our " : "Lo que Dicen Nuestros ";
const titleHighlight = isEn ? "Clients & Partners" : "Clientes & Aliados";
const subtitle = isEn 
  ? "Leading companies and institutions that have transformed their digital channels and accelerated sales with 77 Studio."
  : "Empresas e instituciones líderes que han transformado su canal digital y acelerado sus ventas con 77 Studio.";
