<section class="vertical-testimonials-section bg-slate-50 border-t border-b border-black/5 py-20 sm:py-28 relative overflow-hidden" id="casos-de-exito">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered on Light Background) -->
    <div class="section-header-center">
      <h2 class="section-title-large">
        {titleMain}<span>{titleHighlight}</span>
      </h2>
      <p class="section-subtitle-text">
        {subtitle}
      </p>
    </div>

    <!-- Testimonials Scroll Marquee Grid -->
    <div class="testimonials-marquee-container">
      
      <!-- COLUMNA 1: DESPLAZAMIENTO HACIA ARRIBA (EJE Y) -->
      <div class="marquee-column">
        
        <!-- Card 1: Yamaha del Café -->
        <div class="testimonial-card-v" style="background-image: url('/img/clientes/yamaha-del-cafe.webp');">
          <a href="https://cronicadelquindio.com/armenia/cuidado-perfiles-falsos-siguen-estafando-a-nombre-de-yamaha-del-cafe/" target="_blank" rel="noopener" class="testimonial-external-link" title="Ver publicación">↗</a>
          <div class="testimonial-card-header">
            <img src="/img/clientes/yamaha-logo.webp" alt="Yamaha del Café" class="testimonial-client-logo" width="160" height="44" loading="lazy" decoding="async">
            <div class="testimonial-stars">★★★★★</div>
          </div>
          <p class="testimonial-quote-text">
            “En <strong>3 meses duplicamos los leads</strong> de la sala de ventas. Antes pautábamos sin saber si funcionaba. Ahora tenemos datos y un equipo que los entiende.”
          </p>
          <div class="testimonial-author-block">
            <div class="testimonial-author-info">
              <span class="author-name">Carlos Rivera</span>
              <span class="author-company">Yamaha del Café</span>
            </div>
