<script>
  function initTestimonialsMarquee() {
    const marqueeCols = document.querySelectorAll('.marquee-column');
    if (marqueeCols.length === 3) {
      const marqueeSpeeds = [-0.65, 0.65, -0.65]; // Col 1: ARRIBA, Col 2: ABAJO, Col 3: ARRIBA
      const marqueeOffsets = [0, 0, 0];
      const marqueeHovered = [false, false, false];
      const marqueeDragging = [false, false, false];
      const marqueeStartY = [0, 0, 0];
      const marqueeStartOffset = [0, 0, 0];

      // Inicializar cada columna
      marqueeCols.forEach((col, idx) => {
        const htmlCol = col as HTMLElement;
        
        // Ajustar el offset inicial para la columna que se desplaza hacia abajo (Col 2)
        // para que empiece desplazada la mitad y tenga margen de transición fluido hacia 0
        if (marqueeSpeeds[idx] > 0) {
          const halfHeight = htmlCol.scrollHeight / 2;
          if (halfHeight > 0) {
            marqueeOffsets[idx] = -halfHeight;
          }
        }

        htmlCol.addEventListener('mouseenter', () => { marqueeHovered[idx] = true; });
        htmlCol.addEventListener('mouseleave', () => { marqueeHovered[idx] = false; });

        const startDrag = (e: MouseEvent | TouchEvent) => {
          marqueeDragging[idx] = true;
          marqueeStartY[idx] = e instanceof TouchEvent ? e.touches[0].clientY : e.clientY;
          marqueeStartOffset[idx] = marqueeOffsets[idx];
          htmlCol.style.cursor = 'grabbing';
        };

        const onDrag = (e: MouseEvent | TouchEvent) => {
          if (!marqueeDragging[idx]) return;
          const currentY = e instanceof TouchEvent ? e.touches[0].clientY : e.clientY;
          const deltaY = currentY - marqueeStartY[idx];
          marqueeOffsets[idx] = marqueeStartOffset[idx] + deltaY;
        };

        const stopDrag = () => {
          if (!marqueeDragging[idx]) return;
          marqueeDragging[idx] = false;
          htmlCol.style.cursor = 'grab';
        };

        htmlCol.addEventListener('mousedown', startDrag as EventListener);
        window.addEventListener('mousemove', onDrag as EventListener);
        window.addEventListener('mouseup', stopDrag);

        htmlCol.addEventListener('touchstart', startDrag as EventListener, { passive: true });
        window.addEventListener('touchmove', onDrag as EventListener, { passive: true });
        window.addEventListener('touchend', stopDrag);
      });

      function animateMarqueeLoop() {
        marqueeCols.forEach((col, idx) => {
          const htmlCol = col as HTMLElement;
          const halfHeight = htmlCol.scrollHeight / 2;

          if (!marqueeHovered[idx] && !marqueeDragging[idx]) {
            marqueeOffsets[idx] += marqueeSpeeds[idx];
          }

          if (halfHeight > 0) {
            if (marqueeOffsets[idx] <= -halfHeight) {
              marqueeOffsets[idx] += halfHeight;
            } else if (marqueeOffsets[idx] >= 0) {
              marqueeOffsets[idx] -= halfHeight;
            }
          }

          htmlCol.style.transform = `translate3d(0, ${marqueeOffsets[idx]}px, 0)`;
        });

        requestAnimationFrame(animateMarqueeLoop);
      }

      requestAnimationFrame(animateMarqueeLoop);
    }
  }

  // Inicializar al estar listo el DOM o al navegar (compatibilidad Astro)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonialsMarquee);
  } else {
    initTestimonialsMarquee();
  }
  document.addEventListener('astro:page-load', initTestimonialsMarquee);
</script>
