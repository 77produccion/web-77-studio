---
// src/components/ia/HeroIA.astro
import DualCTA from '@/components/DualCTA.astro';
import { Zap, Bot, Network, Sparkles } from 'lucide-astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getIaTranslations(currentLang);
const isEn = currentLang === 'en';
---

<section 
  class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden bg-cover bg-center bg-no-repeat"
  style="background-image: url('/img/ia-automatizacion-hero.webp');"
>
  <!-- Background tint / overlay -->
  <div class="absolute inset-0 bg-white/85 backdrop-blur-[1px]"></div>

  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-30">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-indigo-500/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Main Headline: IA y automatización para empresas -->
      <h1 data-text-reveal class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-5">
        {isEn ? (
          <>AI and automation <span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">for businesses</span></>
        ) : (
          <>IA y automatización <span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">para empresas</span></>
        )}
      </h1>

      <!-- Hook: Implementa inteligencia artificial donde realmente puede generar valor -->
      <p data-opai-animate data-delay="0.15" class="font-sora text-xl sm:text-2xl text-background-13 font-semibold max-w-3xl mx-auto mb-4 leading-snug">
        {t.hero.subheadlineHighlight}
      </p>

      <!-- Subheadline -->
      <p data-opai-animate data-delay="0.25" class="font-inter-tight text-base sm:text-lg text-background-13/75 max-w-2xl mx-auto mb-9 leading-relaxed">
        {t.hero.subheadline}
      </p>

      <!-- Dual Commercial CTA (WhatsApp IA context + Contact form) -->
      <div data-opai-animate data-delay="0.35">
        <DualCTA
          whatsappContext="ia"
          whatsappText={t.hero.whatsappBtn}
          emailText={t.hero.emailBtn}
          emailHref="#contacto"
          centered={true}
          lang={currentLang}
        />
      </div>

    </div>

    <!-- 4 Clean Pillars Beneath Hero -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-14 max-w-5xl mx-auto">
      
      <!-- Card 1: Workflows -->
      <div data-opai-animate data-delay="0.1" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Zap class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-1.5">
            {isEn ? 'Process Workflows' : 'Automatización'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {isEn
              ? 'Eliminate repetitive manual tasks and speed up operational pipelines.'
              : 'Elimina tareas manuales repetitivas y agiliza flujos de trabajo diarios.'}
          </p>
        </div>
      </div>

      <!-- Card 2: Conexión de Herramientas -->
      <div data-opai-animate data-delay="0.2" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Network class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-1.5">
            {isEn ? 'Connected Tools' : 'Integraciones'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {isEn
              ? 'Connect CRM, databases, messaging, and internal software seamlessly.'
              : 'Conecta tu CRM, bases de datos, mensajería y software operativo.'}
          </p>
        </div>
      </div>

      <!-- Card 3: IA Aplicada -->
      <div data-opai-animate data-delay="0.3" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Bot class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-1.5">
            {isEn ? 'Applied AI' : 'IA Aplicada'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {isEn
              ? 'Contextual AI agents to analyze, classify, and extract actionable insights.'
              : 'Agentes inteligentes para interpretar datos, clasificar y responder 24/7.'}
          </p>
        </div>
      </div>

      <!-- Card 4: Impacto Real -->
      <div data-opai-animate data-delay="0.4" class="rounded-2xl border border-black/10 bg-white/95 p-5 sm:p-6 backdrop-blur-md shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
        <div>
          <div class="h-11 w-11 rounded-xl bg-background-13 text-white flex items-center justify-center mb-4 shadow-xs group-hover:scale-105 transition-transform">
            <Sparkles class="h-5 w-5 text-white" />
          </div>

          <h3 class="font-sora text-base sm:text-lg font-bold text-background-13 mb-1.5">
            {isEn ? 'Better Operations' : 'Operar Mejor'}
          </h3>

          <p class="font-inter-tight text-xs sm:text-sm text-background-13/75 leading-relaxed">
            {isEn
              ? 'Save valuable team hours, reduce error margins, and scale smoothly.'
              : 'Ahorra tiempo valioso, minimiza errores y permite escalar tu operación.'}
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
