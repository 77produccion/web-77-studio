---
// src/components/ia/IACapabilitiesGrid.astro
import {
  Workflow,
  Bot,
  MessageSquareShare,
  Layers
} from 'lucide-astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getIaTranslations(currentLang);
const isEn = currentLang === 'en';

const icons = [Workflow, Bot, MessageSquareShare, Layers];
---

<section id="que-podemos-hacer" class="pt-20 pb-12 sm:pt-28 sm:pb-16 bg-slate-50 relative">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {t.solutions.title}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/70 leading-relaxed max-w-2xl mx-auto">
        {t.solutions.subtitle}
      </p>
    </div>

    <!-- 4 Solutions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {t.solutions.items.map((item, index) => {
        const IconComponent = icons[index % icons.length];
        return (
          <div 
            data-opai-animate
            data-delay={(0.1 * (index + 1)).toFixed(1)}
            class="group relative rounded-[24px] border border-stroke-2/60 bg-white p-7 sm:p-9 transition-all duration-300 hover:shadow-xl hover:border-black/20 hover:border-b-2 hover:border-b-opai-purple flex flex-col justify-between"
          >
            <div>
              <!-- Icon Container: Black fill with White Icon -->
              <div class="mb-6">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white transition-transform group-hover:scale-105 shadow-xs">
                  <IconComponent class="h-6 w-6 text-white" />
                </div>
              </div>

              <!-- Title -->
              <h3 class="font-sora text-2xl font-bold text-background-13 mb-3 group-hover:text-opai-purple transition-colors">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="font-inter-tight text-base text-background-13/75 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
