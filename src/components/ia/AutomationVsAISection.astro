---
// src/components/ia/AutomationVsAISection.astro
import { GitBranch, BrainCircuit, CheckCircle2, ChevronDown } from 'lucide-astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getIaTranslations(currentLang);
const isEn = currentLang === 'en';

const automationTools = [
  { name: "Make (Integromat)", logo: "/img/logos-platforms/make-automation-expert-logo.png" },
  { name: "n8n Workflow Engine", logo: "/img/logos-platforms/n8n-icon.webp" },
  { name: "Zapier Automations", logo: "/img/logos-platforms/zapier.png" }
];

const aiTools = [
  { name: "OpenAI GPT-4o", logo: "/img/logos-platforms/openai-logo.webp" },
  { name: "Anthropic Claude", logo: "/img/logos-platforms/claude-logo.png" },
  { name: "LangChain Framework", logo: "/img/logos-platforms/langchain-logo.png" }
];
---

<section id="comparativa-ia-auto" class="py-20 sm:py-28 bg-[#f4f6fa] relative overflow-hidden border-t border-b border-black/5">
  <!-- Background Degrade Texture (negativo 2 p-100.jpg clearly visible) -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
    <img 
      src="/img/degrades/negativo 2 p-100.jpg" 
      alt="" 
      class="w-full h-full object-cover object-center opacity-50 mix-blend-multiply filter blur-[1px] scale-105"
      loading="lazy"
    />
    <!-- Soft Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#f4f6fa]/50 via-transparent to-[#f4f6fa]/50"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6 relative z-10">
    
    <!-- Section Header (Centered with line break formatting) -->
    <div class="text-center max-w-4xl mx-auto mb-14 sm:mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {isEn ? (
          <>Not everything needs AI. <br class="hidden sm:inline" /> Not everything is solved with simple automation.</>
        ) : (
          <>No todo necesita IA. <br class="hidden sm:inline" /> No todo se resuelve con una automatización simple.</>
        )}
      </h2>
    </div>

    <!-- Comparative Columns Grid with Accordion Behavior (Auto-opens on scroll reveal) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10 max-w-5xl mx-auto" id="automation-ai-grid">
      
      <!-- Column 1: Automatización -->
      <div 
        data-opai-animate 
        data-delay="0.1" 
        class="accordion-compare-card group rounded-[24px] border border-stroke-2/70 bg-white/95 backdrop-blur-md p-7 sm:p-9 shadow-sm hover:shadow-xl hover:border-black/20 transition-all duration-500 flex flex-col justify-between cursor-pointer select-none"
      >
        <div>
          <!-- Header (Click to toggle) -->
          <div class="accordion-header flex items-center justify-between pb-5 mb-5 border-b border-black/5">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform duration-300">
                <GitBranch class="h-6 w-6 text-white" />
              </div>
              <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-blue-600 transition-colors">
                {t.automationVsAi.automation.title}
              </h3>
            </div>

            <!-- Accordion Toggle Chevron -->
            <div class="accordion-chevron p-2 rounded-full bg-black/5 group-hover:bg-blue-50 group-hover:text-blue-600 text-background-13/60 transition-transform duration-500">
              <ChevronDown class="h-5 w-5" />
            </div>
          </div>

          <!-- Expandable Content Container (Smooth grid-template-rows opening) -->
          <div class="accordion-content">
            <div class="overflow-hidden space-y-5 pt-1 pb-2">
              
              <!-- Main Core Action Badge -->
              <div class="p-4 rounded-2xl bg-blue-50/60 border border-blue-100/80 shadow-2xs">
                <p class="font-sora text-lg font-bold text-background-13">
                  {t.automationVsAi.automation.desc}
                </p>
              </div>

              <!-- Principle Statement -->
              <p class="font-inter-tight text-xs text-background-13/65 italic leading-relaxed">
                {t.automationVsAi.automation.principle}
              </p>

              <!-- Emphasized Key Tasks / Bullet Points -->
              <div class="space-y-3 font-inter-tight text-sm text-background-13/85">
                {t.automationVsAi.automation.points.map((pt) => (
                  <div class="p-3.5 rounded-xl bg-slate-50/90 border border-black/5 flex items-start gap-3 shadow-2xs hover:border-blue-200 hover:bg-blue-50/30 transition-all">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-blue-600/10 text-blue-600 mt-0.5">
                      <CheckCircle2 class="size-4 text-blue-600" />
                    </div>
                    <span class="font-inter-tight text-xs sm:text-sm font-semibold text-background-13/90 leading-snug">
                      {pt}
                    </span>
                  </div>
                ))}
              </div>

            </div>
          </div>
        </div>

        <!-- Platform Logos with Floating Tooltips -->
        <div class="mt-8 pt-5 border-t border-black/5">
          <div class="flex items-center justify-center gap-8 sm:gap-10">
            {automationTools.map((tool) => (
              <div class="relative group/tool flex items-center justify-center cursor-pointer" title={tool.name}>
                <img 
                  src={tool.logo} 
                  alt={tool.name} 
                  class="h-7 sm:h-8 w-auto max-w-[85px] object-contain opacity-70 group-hover/tool:opacity-100 group-hover/tool:scale-110 transition-all duration-200" 
                />
                <!-- Floating Tooltip -->
                <div class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 opacity-0 group-hover/tool:opacity-100 transition-all duration-200 bg-background-13 text-white text-[11px] font-ibm-plex-mono py-1 px-2.5 rounded-lg whitespace-nowrap shadow-md z-30">
                  {tool.name}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Column 2: IA -->
      <div 
        data-opai-animate 
        data-delay="0.2" 
        class="accordion-compare-card group rounded-[24px] border border-stroke-2/70 bg-white/95 backdrop-blur-md p-7 sm:p-9 shadow-sm hover:shadow-xl hover:border-black/20 transition-all duration-500 flex flex-col justify-between cursor-pointer select-none"
      >
        <div>
          <!-- Header (Click to toggle) -->
          <div class="accordion-header flex items-center justify-between pb-5 mb-5 border-b border-black/5">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-background-13 text-white shadow-xs group-hover:scale-105 transition-transform duration-300">
                <BrainCircuit class="h-6 w-6 text-white" />
              </div>
              <h3 class="font-sora text-2xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
                {t.automationVsAi.ai.title}
              </h3>
            </div>

            <!-- Accordion Toggle Chevron -->
            <div class="accordion-chevron p-2 rounded-full bg-black/5 group-hover:bg-opai-purple/10 group-hover:text-opai-purple text-background-13/60 transition-transform duration-500">
              <ChevronDown class="h-5 w-5" />
            </div>
          </div>

          <!-- Expandable Content Container (Smooth grid-template-rows opening) -->
          <div class="accordion-content">
            <div class="overflow-hidden space-y-5 pt-1 pb-2">
              
              <!-- Main Core Action Badge -->
              <div class="p-4 rounded-2xl bg-opai-purple/10 border border-opai-purple/20 shadow-2xs">
                <p class="font-sora text-lg font-bold text-background-13">
                  {t.automationVsAi.ai.desc}
                </p>
              </div>

              <!-- Principle Statement -->
              <p class="font-inter-tight text-xs text-background-13/65 italic leading-relaxed">
                {t.automationVsAi.ai.principle}
              </p>

              <!-- Emphasized Key Tasks / Bullet Points -->
              <div class="space-y-3 font-inter-tight text-sm text-background-13/85">
                {t.automationVsAi.ai.points.map((pt) => (
                  <div class="p-3.5 rounded-xl bg-slate-50/90 border border-black/5 flex items-start gap-3 shadow-2xs hover:border-opai-purple/30 hover:bg-opai-purple/5 transition-all">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-lg bg-opai-purple/10 text-opai-purple mt-0.5">
                      <CheckCircle2 class="size-4 text-opai-purple" />
                    </div>
                    <span class="font-inter-tight text-xs sm:text-sm font-semibold text-background-13/90 leading-snug">
                      {pt}
                    </span>
                  </div>
                ))}
              </div>

            </div>
          </div>
        </div>

        <!-- Platform Logos with Floating Tooltips -->
        <div class="mt-8 pt-5 border-t border-black/5">
          <div class="flex items-center justify-center gap-8 sm:gap-10">
            {aiTools.map((tool) => (
              <div class="relative group/tool flex items-center justify-center cursor-pointer" title={tool.name}>
                <img 
                  src={tool.logo} 
                  alt={tool.name} 
                  class="h-7 sm:h-8 w-auto max-w-[85px] object-contain opacity-70 group-hover/tool:opacity-100 group-hover/tool:scale-110 transition-all duration-200" 
                />
                <!-- Floating Tooltip -->
                <div class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 opacity-0 group-hover/tool:opacity-100 transition-all duration-200 bg-background-13 text-white text-[11px] font-ibm-plex-mono py-1 px-2.5 rounded-lg whitespace-nowrap shadow-md z-30">
                  {tool.name}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Final Synergy Takeaway Card -->
    <div data-opai-animate data-delay="0.3" class="max-w-5xl mx-auto rounded-2xl bg-white/90 backdrop-blur-md border border-opai-purple/30 p-6 sm:p-7 shadow-sm text-center flex items-center justify-center">
      <p class="font-sora text-base sm:text-lg font-bold text-background-13">
        {t.automationVsAi.conclusion}
      </p>
    </div>

  </div>
</section>

<style>
  /* Accordion Expand/Collapse Animation using grid-template-rows */
  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .accordion-compare-card.is-open .accordion-content {
    grid-template-rows: 1fr;
  }

  .accordion-compare-card.is-open .accordion-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  function initAutoCompareAccordion() {
    const grid = document.getElementById('automation-ai-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll('.accordion-compare-card');

    // 1. Click toggle handler for manual control
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.group\\/tool')) return; // ignore logo tooltip click

        card.classList.toggle('is-open');
      });
    });

    // 2. IntersectionObserver to reveal & open accordions smoothly as the section scrolls into view
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Trigger smooth open animation on scroll reveal
          setTimeout(() => {
            cards.forEach((card, index) => {
              setTimeout(() => {
                card.classList.add('is-open');
              }, index * 250);
            });
          }, 350);
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2
    });

    observer.observe(grid);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAutoCompareAccordion);
  } else {
    initAutoCompareAccordion();
  }
  document.addEventListener('astro:page-load', initAutoCompareAccordion);
</script>
