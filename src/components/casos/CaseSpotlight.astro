---
import { getCollection } from 'astro:content';

interface Props {
  variant?: 'home' | 'service';
}

const variant = Astro.props.variant ?? 'service';
const cases = (await getCollection('casos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = cases[0];
const href = featured ? `/casos/${featured.id}/` : '/casos/';
---

{featured && variant === 'home' && (
  <section id="casos" class="border-t border-black/5 bg-white py-14 sm:py-16" aria-labelledby="casos-home-heading">
    <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
      <div class="flex flex-col gap-6 rounded-[20px] border border-stroke-2/60 bg-background-8 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="max-w-2xl">
          <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.18em] text-opai-purple">
            <a href="/casos/" class="transition hover:text-background-13">Casos de éxito</a>
          </p>
          <h2 id="casos-home-heading" class="mt-2 font-sora text-2xl font-semibold tracking-tight text-background-13/90 sm:text-3xl">
            {featured.data.client}
          </h2>
          <p class="mt-1 font-inter-tight text-sm text-background-13/70">
            {featured.data.industry} · {featured.data.location}
          </p>
          <p class="mt-3 font-inter-tight text-sm leading-relaxed text-background-13/60 sm:text-base">
            {featured.data.excerpt}
          </p>
        </div>
        <a
          href={href}
          class="inline-flex h-12 shrink-0 items-center justify-center rounded-xl bg-background-4 px-5 font-ibm-plex-mono text-sm text-white transition hover:bg-background-5"
        >
          Ver el caso
        </a>
      </div>
    </div>
  </section>
)}

{featured && variant === 'service' && (
  <section class="border-t border-black/5 bg-white py-10" aria-labelledby="casos-servicio-heading">
    <div class="mx-auto flex max-w-[1290px] flex-col gap-4 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div class="max-w-2xl">
        <h2 id="casos-servicio-heading" class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.18em] text-opai-purple">
          Casos de éxito
        </h2>
        <p class="mt-2 font-sora text-lg font-semibold text-background-13/90">
          {featured.data.client} · {featured.data.location}
        </p>
        <p class="mt-1 font-inter-tight text-sm leading-relaxed text-background-13/60">
          {featured.data.excerpt}
        </p>
      </div>
      <a
        href={href}
        class="inline-flex h-11 shrink-0 items-center justify-center rounded-xl border border-stroke-2/60 bg-background-8 px-4 font-ibm-plex-mono text-sm text-background-13 transition hover:border-opai-purple/40 hover:text-opai-purple"
      >
        Ver el caso
      </a>
    </div>
  </section>
)}
