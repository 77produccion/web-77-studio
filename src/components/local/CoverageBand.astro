---
import { CITIES, HUB_PATH, LOCAL_SERVICES, cityPath, servicePath, type ServiceSlug } from '@/data/local-coverage';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  service?: ServiceSlug;
  lang?: SupportedLocale;
}

const { service, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const serviceMeta = LOCAL_SERVICES.find((item) => item.slug === service);
---

<section class="bg-background-8 py-16 sm:py-20" aria-labelledby="eje-cafetero-band">
  <div class="mx-auto max-w-[1290px] px-5 sm:px-6">
    <p class="font-ibm-plex-mono text-xs font-medium uppercase tracking-[0.18em] text-opai-purple">
      {isEn ? 'Coffee Axis' : 'Eje Cafetero'}
    </p>
    <h2 id="eje-cafetero-band" class="mt-3 max-w-3xl font-sora text-3xl font-semibold tracking-tight text-background-13 sm:text-4xl">
      {isEn
        ? 'Based in Armenia. Pereira and Manizales are served from there.'
        : 'Sede en Armenia. Pereira y Manizales se atienden desde ahí.'}
    </h2>
    <p class="mt-4 max-w-2xl font-inter-tight leading-relaxed text-background-13/70">
      {isEn
        ? 'Marketing, automation, AI agents, and websites for companies in the Coffee Axis. These pages are in Spanish.'
        : 'Marketing digital, automatización, agentes de IA y páginas web para empresas de Armenia, Pereira, Manizales y los municipios cercanos.'}
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {CITIES.map((city) => (
        <a
          href={service ? servicePath(city.slug, service) : cityPath(city.slug)}
          class="rounded-3xl border border-stroke-2 bg-white p-6 transition hover:border-opai-purple/40"
        >
          <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.14em] text-background-13/50">
            {city.hasOffice ? (isEn ? 'Office' : 'Sede') : (isEn ? 'No office' : 'Sin oficina')}
          </p>
          <h3 class="mt-2 font-sora text-xl font-semibold text-background-13">{city.name}</h3>
          <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/65">
            {serviceMeta
              ? (isEn ? `${serviceMeta.name} for ${city.name}.` : `${serviceMeta.name} en ${city.name}.`)
              : (isEn ? city.department : `${city.department}. ${city.hasOffice ? 'Oficina en la carrera 14.' : 'Cobertura desde Armenia.'}`)}
          </p>
        </a>
      ))}
    </div>
    <p class="mt-6 font-inter-tight text-sm">
      <a href={HUB_PATH} class="text-background-13/80 underline decoration-black/20 underline-offset-4 hover:text-opai-purple">
        {isEn ? 'See the full Coffee Axis coverage' : 'Ver toda la cobertura del Eje Cafetero'}
      </a>
    </p>
  </div>
</section>
