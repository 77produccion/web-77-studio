---
import DualCTA from '@/components/DualCTA.astro';
import {
  CITIES,
  HUB_PATH,
  LOCAL_SERVICES,
  WORK_STEPS,
  cityPath,
  getLocalService,
  servicePath,
  type CityPage,
  type Faq,
  type ServiceCityPage,
} from '@/data/local-coverage';
import { OPENING_HOURS_NOTE, PHONE_DISPLAY, PHONE_E164 } from '@/utils/nap';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  h1: string;
  lead: string[];
  whatsappMessage: string;
  faqs: Faq[];
  kind: 'hub' | 'city' | 'service';
  city?: CityPage;
  servicePage?: ServiceCityPage;
}

const { crumbs, eyebrow, h1, lead, whatsappMessage, faqs, kind, city, servicePage } = Astro.props;
const serviceMeta = servicePage ? getLocalService(servicePage.service) : undefined;
const showHours = kind === 'hub' || city?.hasOffice;
---

<article class="bg-background-8">
  <header class="bg-white pt-28 pb-14 sm:pt-36 sm:pb-16">
    <div class="mx-auto max-w-3xl px-5">
      <nav aria-label="Miga de pan" class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.16em] text-background-13/50">
        <ol class="flex flex-wrap gap-x-2 gap-y-1">
          {crumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true">/</span>}
              {index === crumbs.length - 1 ? (
                <span class="text-background-13/80">{crumb.name}</span>
              ) : (
                <a href={crumb.path} class="hover:text-opai-purple">{crumb.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <p class="mt-6 font-ibm-plex-mono text-xs font-medium uppercase tracking-[0.18em] text-opai-purple">{eyebrow}</p>
      <h1 class="mt-3 font-sora text-4xl font-bold leading-[1.12] tracking-tight text-background-13 sm:text-5xl">{h1}</h1>
      {lead.map((paragraph) => (
        <p class="mt-5 font-inter-tight text-lg leading-relaxed text-background-13/70">{paragraph}</p>
      ))}
      <div class="mt-8">
        <DualCTA
          whatsappMessage={whatsappMessage}
          whatsappText="Hablar por WhatsApp"
          emailText="Escribir por el formulario"
          emailHref="/contacto/"
          centered={false}
        />
      </div>
      <p class="mt-4 font-inter-tight text-sm text-background-13/60">
        Teléfono de Colombia:
        <a href={`tel:${PHONE_E164}`} class="font-semibold text-background-13 underline decoration-black/20 underline-offset-4">{PHONE_DISPLAY}</a>
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-3xl space-y-8 px-5 py-12">
    {kind === 'hub' && (
      <>
        <section aria-labelledby="ciudades-heading">
          <h2 id="ciudades-heading" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Sede en Armenia, foco en tres ciudades</h2>
          <div class="mt-5 grid gap-4">
            {CITIES.map((item) => (
              <a href={cityPath(item.slug)} class="block rounded-3xl border border-stroke-2 bg-white p-6 transition hover:border-opai-purple/40">
                <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.16em] text-background-13/50">
                  {item.hasOffice ? 'Sede principal' : 'Cobertura nacional'} · {item.department}
                </p>
                <h3 class="mt-2 font-sora text-xl font-semibold text-background-13">{item.name}</h3>
                <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{item.lead[0]}</p>
              </a>
            ))}
          </div>
        </section>
        <section aria-labelledby="servicios-hub">
          <h2 id="servicios-hub" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Servicios con página en cada ciudad</h2>
          <p class="mt-3 font-inter-tight leading-relaxed text-background-13/70">
            Hay una página por servicio en Armenia, Pereira y Manizales. Productos digitales —software, SaaS y tableros— se cotizan desde la sede de Armenia para todo el país. El encargo es el mismo en cada ciudad, así que vive en la página general de productos.
          </p>
          <ul class="mt-4 space-y-2">
            {LOCAL_SERVICES.map((service) => (
              <li>
                <a href={service.parentPath} class="font-inter-tight text-background-13/80 underline decoration-black/20 underline-offset-4 hover:text-opai-purple">{service.name}</a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}

    {kind === 'city' && city && (
      <>
        <section aria-labelledby="economia">
          <h2 id="economia" class="font-sora text-2xl font-semibold tracking-tight text-background-13">{city.economyTitle}</h2>
          {city.economy.map((paragraph) => (
            <p class="mt-4 font-inter-tight leading-relaxed text-background-13/75">{paragraph}</p>
          ))}
        </section>
        <section aria-labelledby="sectores">
          <h2 id="sectores" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Dónde encaja el trabajo</h2>
          <div class="mt-4 grid gap-3">
            {city.sectors.map((sector) => (
              <div class="rounded-[20px] border border-stroke-2 bg-white p-5">
                <h3 class="font-sora text-lg font-semibold text-background-13/90">{sector.title}</h3>
                <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{sector.text}</p>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="servicios-ciudad">
          <h2 id="servicios-ciudad" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Servicios para esta ciudad</h2>
          <div class="mt-4 grid gap-3">
            {LOCAL_SERVICES.map((service) => (
              <a href={servicePath(city.slug, service.slug)} class="block rounded-[20px] border border-stroke-2 bg-white p-5 transition hover:border-opai-purple/40">
                <h3 class="font-sora text-lg font-semibold text-background-13">{service.name}</h3>
                <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{city.serviceNotes[service.slug]}</p>
              </a>
            ))}
          </div>
        </section>
        <section aria-labelledby="municipios">
          <h2 id="municipios" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Municipios de la cobertura</h2>
          <p class="mt-3 font-inter-tight leading-relaxed text-background-13/75">{city.municipalitiesIntro}</p>
          <ul class="mt-4 space-y-3">
            {city.municipalities.map((place) => (
              <li class="rounded-[20px] border border-stroke-2 bg-white px-5 py-4">
                <p class="font-sora font-semibold text-background-13">{place.name} <span class="font-inter-tight text-sm font-normal text-background-13/50">· {place.department}</span></p>
                <p class="mt-1 font-inter-tight text-sm leading-relaxed text-background-13/70">{place.note}</p>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}

    {kind === 'service' && city && servicePage && serviceMeta && (
      <>
        {servicePage.sections.map((section) => (
          <section>
            <h2 class="font-sora text-2xl font-semibold tracking-tight text-background-13">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="mt-4 font-inter-tight leading-relaxed text-background-13/75">{paragraph}</p>
            ))}
          </section>
        ))}
        <section aria-labelledby="situaciones">
          <h2 id="situaciones" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Situaciones concretas</h2>
          <div class="mt-4 grid gap-3">
            {servicePage.situations.map((item) => (
              <div class="rounded-[20px] border border-stroke-2 bg-white p-5">
                <h3 class="font-sora text-lg font-semibold text-background-13/90">{item.title}</h3>
                <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{item.text}</p>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="otras-ciudades" class="rounded-3xl border border-stroke-2 bg-white p-6">
          <h2 id="otras-ciudades" class="font-sora text-xl font-semibold text-background-13">El mismo servicio en otras ciudades</h2>
          <ul class="mt-3 space-y-2 font-inter-tight text-sm">
            <li><a class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple" href={cityPath(city.slug)}>{city.name}: vista general</a></li>
            <li><a class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple" href={serviceMeta.parentPath}>{serviceMeta.parentLabel} en todo el sitio</a></li>
            {CITIES.filter((item) => item.slug !== city.slug).map((item) => (
              <li>
                <a class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple" href={servicePath(item.slug, servicePage.service)}>
                  {serviceMeta.name} en {item.name}
                </a>
              </li>
            ))}
            <li><a class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple" href={HUB_PATH}>Cobertura del Eje Cafetero</a></li>
          </ul>
        </section>
      </>
    )}

    <section aria-labelledby="proceso">
      <h2 id="proceso" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Cómo trabajamos</h2>
      {city && <p class="mt-3 font-inter-tight leading-relaxed text-background-13/75">{city.processNote}</p>}
      {kind === 'hub' && (
        <p class="mt-3 font-inter-tight leading-relaxed text-background-13/75">
          El mismo proceso aplica en Armenia, Pereira, Manizales y el resto del país. En Armenia nos vemos en la sede. En las demás ciudades combinamos reuniones presenciales y trabajo remoto.
        </p>
      )}
      <ol class="mt-4 grid gap-3 sm:grid-cols-2">
        {WORK_STEPS.map((step, index) => (
          <li class="rounded-[20px] border border-stroke-2 bg-white p-5">
            <p class="font-ibm-plex-mono text-xs text-opai-purple">0{index + 1}</p>
            <h3 class="mt-1 font-sora text-lg font-semibold text-background-13">{step.name}</h3>
            <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    {showHours && (
      <p class="rounded-[20px] border border-stroke-2 bg-white px-5 py-4 font-inter-tight text-sm leading-relaxed text-background-13/70">
        {OPENING_HOURS_NOTE}
      </p>
    )}

    <section aria-labelledby="faq-local">
      <h2 id="faq-local" class="font-sora text-2xl font-semibold tracking-tight text-background-13">Preguntas frecuentes</h2>
      <div class="mt-4 divide-y divide-black/10 rounded-3xl border border-stroke-2 bg-white px-5">
        {faqs.map((faq) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-sora text-base font-semibold text-background-13/90 marker:content-none">
              {faq.question}
            </summary>
            <p class="mt-2 font-inter-tight text-sm leading-relaxed text-background-13/70">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    {kind === 'city' && city && (
      <p class="font-inter-tight text-sm text-background-13/60">
        También: {CITIES.filter((item) => item.slug !== city.slug).map((item, index) => (
          <>
            {index > 0 && ' · '}
            <a href={cityPath(item.slug)} class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple">{item.name}</a>
          </>
        ))}
        {' · '}
        <a href={HUB_PATH} class="underline decoration-black/20 underline-offset-4 hover:text-opai-purple">Eje Cafetero</a>
      </p>
    )}

    <section class="rounded-3xl bg-background-13 px-6 py-8 text-white">
      <h2 class="font-sora text-2xl font-semibold">Cuéntanos qué se está atorantando</h2>
      <p class="mt-3 max-w-xl font-inter-tight text-sm leading-relaxed text-white/70">
        Escribe por WhatsApp al {PHONE_DISPLAY} o deja los datos en el formulario. Revisamos el caso y te decimos si tiene sentido trabajarlo.
      </p>
      <div class="mt-6">
        <DualCTA
          whatsappMessage={whatsappMessage}
          whatsappText="Escribir por WhatsApp"
          emailText="Ir a contacto"
          emailHref="/contacto/"
          centered={false}
        />
      </div>
    </section>
  </div>
</article>
