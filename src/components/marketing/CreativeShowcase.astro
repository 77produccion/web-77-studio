---
// src/components/marketing/CreativeShowcase.astro
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const creativeTypes = isEn ? [
  {
    title: "High-Retention Reels & TikTok Ads",
    description: "Battle-tested ad structure: Visual hook at 0-3s → Pain point agitation → Solution demonstration → Frictionless call-to-action.",
    bgImage: "/img/degrades/negativo 1 p-100.jpg",
    rightImage: "/img/bgs/juli-edit.webp"
  },
  {
    title: "Ultra-Clear Single Image Ads",
    description: "Minimalist visual typography and persuasive microcopy. The value proposition is understood in less than 1 second of scrolling.",
    bgImage: "/img/degrades/negativo 3 p-100.jpg",
    rightImage: "/img/bgs/set-bio.webp"
  },
  {
    title: "Objection-Crushing Carousels",
    description: "5 to 7 slide storytelling sequence that educates buyers, contrasts before vs after, and eliminates objections before they reach sales.",
    bgImage: "/img/degrades/positivo 2 p-100.jpg",
    rightImage: "/img/bgs/camera2.webp"
  },
  {
    title: "AI-Powered Creative Iterations for A/B Testing",
    description: "Rapid production of visual background variations, headline angles, and hooks to prevent ad fatigue and scale ad spend.",
    bgImage: "/img/degrades/postivo 3 p-100.jpg",
    rightImage: "/img/bgs/ads-lettering.webp"
  }
] : [
  {
    title: "Reels & TikTok Ads de Alta Retención",
    description: "Estructura publicitaria: Hook visual en el segundo 0-3 → Identificación del dolor → Demostración de solución → Llamada a la acción precisa.",
    bgImage: "/img/degrades/negativo 1 p-100.jpg",
    rightImage: "/img/bgs/juli-edit.webp"
  },
  {
    title: "Single Image Ads de Alta Claridad",
    description: "Diseño visual minimalista con tipografías Sora y microcopy persuasivo. La propuesta de valor se entiende en menos de 1 segundo de scroll.",
    bgImage: "/img/degrades/negativo 3 p-100.jpg",
    rightImage: "/img/bgs/set-bio.webp"
  },
  {
    title: "Carruseles de Demolición de Objeciones",
    description: "Secuencia de 5 a 7 tarjetas que educan al prospecto, comparan el antes vs después y resuelven dudas antes de hacer clic al WhatsApp.",
    bgImage: "/img/degrades/positivo 2 p-100.jpg",
    rightImage: "/img/bgs/camera2.webp"
  },
  {
    title: "Iteraciones Creativas para A/B Testing",
    description: "Generación acelerada de variantes de fondos, titulares y ángulos de dolor asistidos por IA para evitar el desgaste de fatiga publicitaria.",
    bgImage: "/img/degrades/postivo 3 p-100.jpg",
    rightImage: "/img/bgs/ads-lettering.webp"
  }
];

const title = isEn
  ? "Algorithms reward the highest-quality creative content."
  : "El algoritmo premia al mejor contenido publicitario.";

const subtitle = isEn
  ? "70% of an ad's performance comes down to the creative asset. We engineer formats designed to stop the scroll and capture intentional buyer clicks."
  : "El 70% del éxito de un anuncio depende de la pieza creativa. Diseñamos formatos estructurados científicamente para detener el scroll y generar clics intencionales.";
---

<section class="py-20 sm:py-28 bg-white relative overflow-hidden border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-5xl mx-auto mb-12 sm:mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight">
        {title}
      </h2>
    </div>

    <!-- Creative Mosaic Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {creativeTypes.map((item, index) => {
        const delay = (0.1 * (index + 1)).toFixed(1);
        return (
          <div 
            data-opai-animate 
            data-delay={delay}
            class="group relative rounded-[28px] border border-black/10 overflow-hidden bg-background-13 text-white transition-all duration-300 hover:shadow-2xl"
          >
            <!-- Background Image -->
            <img 
              src={item.bgImage} 
              alt="" 
              class="absolute inset-0 w-full h-full object-cover object-center z-0 transition-transform duration-700 group-hover:scale-105" 
            />
            
            <!-- Dark Overlay -->
            <div class="absolute inset-0 bg-black/65 z-[1]"></div>

            <!-- Card Content Container -->
            <div class="p-7 sm:p-9 flex flex-col sm:flex-row items-center justify-between gap-6 min-h-[260px] relative z-10">
              
              <!-- Left Text Content -->
              <div class="flex-1">
                <!-- Title -->
                <h3 class="font-sora text-2xl font-bold text-white mb-3 group-hover:text-opai-purple transition-colors">
                  {item.title}
                </h3>

                <!-- Description -->
                <p class="font-inter-tight text-sm sm:text-base text-white/85 leading-relaxed">
                  {item.description}
                </p>
              </div>

              <!-- Right Image Thumbnail -->
              <div class="w-full sm:w-36 lg:w-44 h-40 sm:h-36 lg:h-44 shrink-0 rounded-2xl overflow-hidden border border-white/20 shadow-xl relative group-hover:border-white/40 transition-all">
                <img 
                  src={item.rightImage} 
                  alt={item.title} 
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110" 
                />
              </div>

            </div>

            <!-- Subtle Background Hover Glow Effect -->
            <div class="absolute inset-0 bg-gradient-to-t from-opai-purple/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-[2]"></div>
          </div>
        );
      })}
    </div>

  </div>
</section>

