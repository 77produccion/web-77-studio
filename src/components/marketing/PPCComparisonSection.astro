---
// src/components/marketing/PPCComparisonSection.astro
import { XCircle, CheckCircle2 } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const title = isEn
  ? "Running ads isn't just about clicking a button and boosting posts."
  : "Pautar no es solo oprimir un botón y activar anuncios.";

const subtitle = isEn
  ? "80% of digital ad spend is wasted when campaigns operate in isolation from web speed, creative hooks, and instant sales follow-ups."
  : "El 80% del presupuesto de pauta digital se desperdicia cuando los anuncios están desconectados de la web, la creatividad y el seguimiento comercial.";
---

<section class="py-20 sm:py-28 bg-white relative overflow-hidden border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Section Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight">
        {title}
      </h2>
    </div>

    <!-- Comparative Columns Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- Column 1: Traditional Disconnected Approach (Negative) -->
      <div 
        data-opai-animate 
        data-delay="0.1" 
        class="rounded-[24px] border border-red-200/70 bg-red-50/20 p-6 sm:p-8 flex flex-col justify-between"
      >
        <div>
          <div class="pb-5 mb-5 border-b border-red-200/50">
            <div>
              <span class="font-ibm-plex-mono text-[11px] font-semibold text-red-600 uppercase tracking-wider block mb-1">
                {isEn ? "Traditional Model" : "Modelo Tradicional"}
              </span>
              <h3 class="font-sora text-lg sm:text-xl font-bold text-background-13">
                {isEn ? "Disconnected Campaigns" : "Campañas Desconectadas"}
              </h3>
            </div>
          </div>

          <!-- 2x2 Mini Cards Grid (Red Background & White Text) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-inter-tight">
            {isEn ? (
              <>
                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Slow Web Pages</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Blind Tracking</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Generic Stock Ads</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Delayed Sales</span>
                </div>
              </>
            ) : (
              <>
                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Webs Lentas</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Medición a Ciegas</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Anuncios Genéricos</span>
                </div>

                <div class="rounded-xl border border-red-400/40 bg-red-500 text-white p-3.5 flex items-center gap-2.5 shadow-2xs">
                  <XCircle class="h-4 w-4 text-white shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Respuesta Tardía</span>
                </div>
              </>
            )}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-red-200/50 font-ibm-plex-mono text-xs text-red-700 font-medium flex items-center justify-between">
          <span>{isEn ? "Typical Result:" : "Resultado Típico:"}</span>
          <span class="font-bold">{isEn ? "Wasted budget & high CAC" : "Presupuesto quemado & CPL elevado"}</span>
        </div>
      </div>

      <!-- Column 2: 77 Studio Connected System (Positive - Dark Purple Gradient Background) -->
      <div 
        data-opai-animate 
        data-delay="0.2" 
        class="rounded-[24px] border border-white/20 p-6 sm:p-8 shadow-xl flex flex-col justify-between relative text-white"
      >
        <!-- Background Image (Clipped to Card Corners) -->
        <div class="absolute inset-0 rounded-[24px] overflow-hidden -z-10">
          <img 
            src="/img/degrades/negativo 4 p-100.jpg" 
            alt="" 
            aria-hidden="true" 
            class="w-full h-full object-cover" 
          / loading="lazy" decoding="async" />
        </div>

        <!-- Overlaid Superimposed White Circle Badge with 77 Studio Logo -->
        <div class="absolute -top-6 right-1 sm:right-2 z-20">
          <div class="h-14 w-14 sm:h-16 sm:w-16 rounded-full bg-white shadow-xl shadow-black/35 flex items-center justify-center p-2 border-2 border-white/90 overflow-hidden transition-transform hover:scale-105">
            <img 
              src="/img/logo-variaciones/negro5.webp" 
              alt="77 Studio Logo" 
              class="h-full w-full object-contain scale-130" 
            / loading="lazy" decoding="async" />
          </div>
        </div>

        <div>
          <div class="pb-5 mb-5 border-b border-white/20">
            <div>
              <span class="font-ibm-plex-mono text-[11px] font-semibold text-purple-200 uppercase tracking-wider block mb-1">
                {isEn ? "Our Unified Ecosystem" : "Nuestro Ecosistema Unificado"}
              </span>
              <h3 class="font-sora text-lg sm:text-xl font-bold text-white">
                {isEn ? "Connected Growth System" : "Sistema de Marketing Conectado"}
              </h3>
            </div>
          </div>

          <!-- 2x2 Mini Cards Grid (Purple / White Glassmorphism) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-inter-tight">
            {isEn ? (
              <>
                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Validated Hooks</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Sub-Second Landings</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">CAPI + GA4 Tracking</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Instant Response</span>
                </div>
              </>
            ) : (
              <>
                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Hooks Validados</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Landings Ultra Rápidas</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Tracking CAPI + GA4</span>
                </div>

                <div class="rounded-xl border border-white/20 bg-white/10 backdrop-blur-md p-3.5 flex items-center gap-2.5 shadow-xs">
                  <CheckCircle2 class="h-4 w-4 text-purple-200 shrink-0" />
                  <span class="font-semibold text-white text-xs sm:text-sm">Respuesta Inmediata</span>
                </div>
              </>
            )}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/20 font-ibm-plex-mono text-xs text-purple-200 font-semibold flex items-center justify-between">
          <span>{isEn ? "Verified Result:" : "Resultado Validado:"}</span>
          <span class="font-bold text-white">{isEn ? "Higher ROAS & qualified pipeline" : "Mayor ROAS & leads calificados"}</span>
        </div>
      </div>

    </div>

    <!-- Bottom Description Highlight -->
    <div data-opai-animate data-delay="0.3" class="mt-12 sm:mt-16 text-center max-w-3xl mx-auto">
      <p class="font-inter-tight text-base sm:text-lg lg:text-xl font-medium text-background-13/80 leading-relaxed">
        {subtitle}
      </p>
    </div>

  </div>
</section>
