---
// src/components/marketing/HeroMarketing.astro
import DualCTA from '@/components/DualCTA.astro';
import { getMarketingTranslations } from '@/lib/i18n/pages/marketing';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const t = getMarketingTranslations(currentLang);
---

<section class="relative pt-36 pb-16 sm:pt-44 sm:pb-24 overflow-hidden">
  <!-- Background Photographic Image shifted down for optimal framing -->
  <img 
    src="/img/bgs/tania-licxa-work.webp" 
    alt="77 Studio Marketing" 
    loading="eager" 
    decoding="async" 
    class="absolute inset-0 w-full h-full object-cover object-[center_35%] pointer-events-none"
  />

  <!-- Light Overlay for High Legibility -->
  <div class="absolute inset-0 bg-white/75 backdrop-blur-[1px]"></div>

  <!-- Ambient Gradient Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-40">
    <div class="h-[520px] w-[520px] rounded-full bg-gradient-to-tr from-opai-purple/15 to-transparent blur-[130px]"></div>
    <div class="h-[420px] w-[420px] rounded-full bg-gradient-to-bl from-amber-400/10 to-transparent blur-[110px] -translate-y-20"></div>
  </div>

  <div class="mx-auto max-w-[1290px] px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Main Headline -->
      <h1 data-text-reveal class="font-sora text-4xl sm:text-6xl lg:text-[62px] font-bold tracking-tight text-background-13 leading-[1.12] mb-6">
        {t.hero.headline}<span class="bg-gradient-to-r from-background-13 via-opai-purple to-background-13 bg-clip-text text-transparent">{t.hero.headlineHighlight}</span>{t.hero.headlineSuffix}
      </h1>

      <!-- Subheadline -->
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-lg sm:text-xl text-background-13/75 max-w-3xl mx-auto mb-9 leading-relaxed">
        {t.hero.subheadline}
      </p>

      <!-- Dual Commercial CTA (WhatsApp Marketing context + Contact form) -->
      <div data-opai-animate data-delay="0.3">
        <DualCTA
          whatsappContext="marketing"
          whatsappText={t.hero.whatsappBtn}
          emailText={t.hero.emailBtn}
          emailHref="#contacto"
          centered={true}
          lang={currentLang}
        />
      </div>

    </div>
  </div>
</section>
