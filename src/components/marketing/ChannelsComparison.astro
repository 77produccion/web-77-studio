---
// src/components/marketing/ChannelsComparison.astro
import { ArrowRight, Repeat } from 'lucide-astro';
import type { SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const isEn = currentLang === 'en';

const title = isEn
  ? "Meta Ads vs. Google Ads: They don't compete, they compound."
  : "Meta Ads vs. Google Ads: No compiten, se multiplican.";

const subtitle = isEn
  ? "The common mistake is choosing one or the other. High-growth strategy uses them as a unified acquisition pincer: Meta sparks demand while Google captures high intent."
  : "El error común es elegir uno u otro. La estrategia de alto impacto consiste en usarlos como una pinza comercial: Meta despierta la demanda y Google captura la intención.";
---

<section class="py-20 sm:py-28 bg-white relative border-t border-black/5">
  <div class="mx-auto max-w-[1290px] px-4 sm:px-6">
    
    <!-- Header (Centered) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 data-text-reveal class="font-sora text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-background-13 leading-tight mb-4">
        {title}
      </h2>
      <p data-opai-animate data-delay="0.2" class="font-inter-tight text-base sm:text-lg text-background-13/75 leading-relaxed max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <!-- Dual Channel Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      
      <!-- Card 1: Meta Ads (Demand Generation) -->
      <div 
        data-opai-animate 
        data-delay="0.1" 
        class="group rounded-[28px] border border-stroke-2/60 border-b-2 border-b-transparent bg-slate-50/70 p-7 sm:p-9 shadow-xs hover:bg-white hover:shadow-xl hover:border-black/20 hover:border-b-opai-purple transition-all duration-300 flex flex-col justify-between relative overflow-hidden"
      >
        <!-- Meta Background Logo (Centered & Large) -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[420px] h-[320px] sm:h-[420px] pointer-events-none opacity-[0.06] group-hover:opacity-[0.11] transition-opacity z-0">
          <img 
            src="/img/logos-platforms/meta-logo.avif" 
            alt="" 
            aria-hidden="true" 
            class="w-full h-full object-contain" 
          / loading="lazy" decoding="async" />
        </div>

        <div class="relative z-10">
          <div class="pb-4 mb-5 border-b border-black/5">
            <h3 class="font-sora text-2xl sm:text-3xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
              Meta Ads
            </h3>
          </div>

          <div class="font-sora text-lg font-semibold text-background-13 mb-3">
            {isEn ? "Generate Demand & Spark Desire" : "Generar Demanda & Despertar Interés"}
          </div>

          <p class="font-inter-tight text-sm sm:text-base text-background-13/75 mb-6 leading-relaxed">
            {isEn
              ? "Your future client doesn't know you exist or isn't actively searching for your service yet. Meta Ads interrupts their scroll with compelling visual storytelling, creating the need and cementing top-of-mind brand authority."
              : "Tu cliente no sabe que existes o no está buscando activamente tu servicio en este momento. Meta Ads interrumpe su feed con contenido visual relevante, crea la necesidad y posiciona tu marca en su mente."}
          </p>

          <!-- 3 Columns Row (Hover Degrade Image + Overlay + White Text) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 font-inter-tight">
            {isEn ? (
              <>
                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Targeting
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Formats
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Remarketing
                  </span>
                </div>
              </>
            ) : (
              <>
                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Audiencias
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Formatos
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Remarketing
                  </span>
                </div>
              </>
            )}
          </div>
        </div>
      </div>

      <!-- Card 2: Google Ads (Intent Capture) -->
      <div 
        data-opai-animate 
        data-delay="0.2" 
        class="group rounded-[28px] border border-stroke-2/60 border-b-2 border-b-transparent bg-slate-50/70 p-7 sm:p-9 shadow-xs hover:bg-white hover:shadow-xl hover:border-black/20 hover:border-b-opai-purple transition-all duration-300 flex flex-col justify-between relative overflow-hidden"
      >
        <!-- Google Background Logo (Centered & Large) -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[420px] h-[320px] sm:h-[420px] pointer-events-none opacity-[0.06] group-hover:opacity-[0.11] transition-opacity z-0">
          <img 
            src="/img/logos-platforms/Google_Favicon_2025.svg.webp" 
            alt="" 
            aria-hidden="true" 
            class="w-full h-full object-contain" 
          / loading="lazy" decoding="async" />
        </div>

        <div class="relative z-10">
          <div class="pb-4 mb-5 border-b border-black/5">
            <h3 class="font-sora text-2xl sm:text-3xl font-bold text-background-13 group-hover:text-opai-purple transition-colors">
              Google Ads
            </h3>
          </div>

          <div class="font-sora text-lg font-semibold text-background-13 mb-3">
            {isEn ? "Capture Active Purchase Intent" : "Capturar Intención Activa de Compra"}
          </div>

          <p class="font-inter-tight text-sm sm:text-base text-background-13/75 mb-6 leading-relaxed">
            {isEn
              ? "The buyer already knows what they need, has urgency, and is searching Google for the best provider to hire today. Google Ads positions your company at the very top at that critical decision point."
              : "El cliente ya sabe qué necesita, tiene urgencia y está buscando en Google la mejor opción para contratar o comprar hoy mismo. Google Ads coloca tu empresa en la primera posición exacta en ese instante crítico."}
          </p>

          <!-- 3 Columns Row (Hover Degrade Image + Overlay + White Text) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 font-inter-tight">
            {isEn ? (
              <>
                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    High-Intent Search
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Performance Max
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Direct Action
                  </span>
                </div>
              </>
            ) : (
              <>
                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Búsqueda de Alta Intención
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Performance Max
                  </span>
                </div>

                <div class="group/pill relative overflow-hidden p-3 rounded-2xl bg-white border border-black/5 text-center shadow-2xs font-semibold text-xs sm:text-sm text-background-13 transition-all duration-300 cursor-pointer">
                  <div class="absolute inset-0 opacity-0 group-hover/pill:opacity-100 transition-opacity duration-300 -z-0 overflow-hidden">
                    <img 
                      src="/img/degrades/negativo 1 p-100.jpg" 
                      alt="" 
                      aria-hidden="true" 
                      class="w-full h-full object-cover" 
                    / loading="lazy" decoding="async" />
                    <div class="absolute inset-0 bg-black/35"></div>
                  </div>
                  <span class="relative z-10 group-hover/pill:text-white transition-colors duration-300">
                    Conversión Inmediata
                  </span>
                </div>
              </>
            )}
          </div>
        </div>
      </div>

    </div>

    <!-- Synergy Integration Banner -->
    <div 
      data-opai-animate 
      data-delay="0.3" 
      class="rounded-[24px] bg-background-13 text-white p-7 sm:p-9 border border-white/10 shadow-xl"
    >
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 font-ibm-plex-mono text-xs text-opai-purple uppercase font-semibold">
            <Repeat class="h-4 w-4" /> {isEn ? "The 77 Conversion Loop" : "El Bucle de Conversión 77"}
          </div>
          <h4 class="font-sora text-xl sm:text-2xl font-bold">
            {isEn 
              ? "Meta sparks desire → Google captures search → Your web converts."
              : "Meta despierta el deseo → Google captura la búsqueda → Tu web convierte."}
          </h4>
          <p class="font-inter-tight text-sm text-white/70 max-w-2xl">
            {isEn
              ? "When a decision-maker sees your ad on Instagram and later searches for your service on Google, your coordinated multi-channel authority establishes you as the undisputed market leader."
              : "Cuando un prospecto ve tu anuncio en Instagram y luego busca tu servicio en Google, tu presencia coordinada genera una percepción de líder indiscutible en la industria."}
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-3">
          <a
            href="#contacto"
            class="font-ibm-plex-mono text-xs uppercase tracking-wider bg-opai-purple hover:bg-opai-purple/90 text-white px-6 py-3.5 rounded-xl transition-all font-medium inline-flex items-center gap-2"
          >
            <span>{isEn ? "Design My Strategy" : "Diseñar mi Estrategia"}</span> <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
