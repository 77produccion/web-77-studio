---
import { getWhatsAppUrl } from '@/utils/whatsapp';

interface Props {
  title: string;
}

const { title } = Astro.props;
const whatsappUrl = getWhatsAppUrl(
  `Hola 77 Studio 👋 Leí «${title}» y quisiera revisar el seguimiento de WhatsApp de mi empresa.`
);
---

<aside class="rounded-[20px] border border-stroke-2 bg-white p-6 shadow-sm md:p-8">
  <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.16em] text-opai-purple">Siguiente paso</p>
  <h2 class="mt-3 font-sora text-2xl font-semibold leading-snug tracking-tight text-background-13">
    Revisemos el tramo entre el anuncio y la respuesta
  </h2>
  <p class="mt-3 max-w-xl font-inter-tight text-base leading-relaxed text-background-13/60">
    Si los mensajes llegan y nadie tiene claro quién responde, subir la pauta no ordena el seguimiento. Te orientamos con un diagnóstico inicial.
  </p>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex h-12 items-center justify-center rounded-xl bg-opai-purple px-5 font-ibm-plex-mono text-sm text-white transition hover:bg-opai-purple-hover"
    >
      Escribir por WhatsApp
    </a>
    <a
      href="/contacto/"
      class="inline-flex h-12 items-center justify-center rounded-xl border border-stroke-2 bg-background-8 px-5 font-ibm-plex-mono text-sm text-background-13 transition hover:bg-background-10"
    >
      Ir a contacto
    </a>
  </div>
</aside>
