---
// src/components/chat/AIChatWidget.astro
import '@/styles/chat-widget.css';
import { getWhatsAppUrl, type WhatsAppContext } from '@/utils/whatsapp';
import { uiTranslations, type SupportedLocale } from '@/lib/i18n/ui';

interface Props {
  whatsappContext?: WhatsAppContext;
  apiEndpoint?: string;
  lang?: SupportedLocale;
}

const currentLang = (Astro.props.lang || (Astro.currentLocale as SupportedLocale) || 'es') as SupportedLocale;
const {
  whatsappContext = 'home',
  apiEndpoint = '/api/chat'
} = Astro.props;

const t = uiTranslations[currentLang].chat;
const fallbackWhatsAppUrl = getWhatsAppUrl(whatsappContext, undefined, currentLang);
---

<div class="ai-chat-widget" id="aiChatWidget" data-api-endpoint={apiEndpoint} data-whatsapp-url={fallbackWhatsAppUrl} data-context={whatsappContext} data-lang={currentLang}>
  <!-- Botón Flotante Disparador -->
  <button class="chat-trigger-btn" id="chatTriggerBtn" aria-label={t.triggerTitle} title={t.triggerTitle}>
    <img src="/img/77studio.webp" alt="77 Studio" class="trigger-logo-img" width="36" height="36" loading="lazy" decoding="async" />
    <span class="trigger-online-dot" id="chatTriggerOnlineDot" title={t.connectedStatus} data-tooltip={t.connectedStatus}></span>
    <span class="trigger-badge-count" id="triggerBadgeCount">1</span>
  </button>

  <!-- Ventana Flotante del Chat -->
  <div class="chat-window" id="chatWindow" role="dialog" aria-modal="true" aria-label={t.botName}>
    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header-info">
        <div class="chat-avatar-box">
          <img src="/img/sofIA/profile-sofia-pic.webp" alt={t.botName} class="chat-avatar-img" onerror="this.src='/img/77studio.webp'" / loading="lazy" decoding="async" />
          <span class="avatar-status-dot" id="chatAvatarStatusDot" title={t.connectedStatus} data-tooltip={t.connectedStatus}></span>
        </div>
        <div class="chat-header-text">
          <div class="chat-bot-name">
            <span>{t.botName}</span>
            <img src="/img/sofIA/verified.webp" alt="Verificada" class="bot-verified-img" title={t.verifiedBadge} / loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div class="chat-header-actions">
        <button class="chat-action-btn" id="chatMinimizeBtn" aria-label={t.minimize} title={t.minimize}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Cuerpo de Mensajes -->
    <div class="chat-body" id="chatBody"></div>

    <!-- Formulario Footer -->
    <form class="chat-footer-form" id="chatFooterForm">
      <input
        type="text"
        id="chatInputText"
        class="chat-input-text"
        placeholder={t.placeholder}
        autocomplete="off"
        required
      />
      <button type="submit" class="chat-send-btn" id="chatSendBtn" aria-label={t.sendAria}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script src="@/scripts/chat-widget.ts"></script>
