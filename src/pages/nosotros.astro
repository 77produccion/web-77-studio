---
// src/pages/nosotros.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroNosotros from '@/components/nosotros/HeroNosotros.astro';
import TeamRosterSection from '@/components/nosotros/TeamRosterSection.astro';
import EvolutionTimeline from '@/components/nosotros/EvolutionTimeline.astro';
import PhilosophySection from '@/components/nosotros/PhilosophySection.astro';
import TeamCapabilitiesGrid from '@/components/nosotros/TeamCapabilitiesGrid.astro';
import GlobalPresenceSection from '@/components/nosotros/GlobalPresenceSection.astro';
import NosotrosContactSection from '@/components/nosotros/NosotrosContactSection.astro';
import { getNosotrosTranslations } from '@/lib/i18n/pages/nosotros';

const t = getNosotrosTranslations('es');
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  whatsappContext="nosotros"
  heroImage="/img/bgs/full-team.webp"
>
  <!-- 01. Hero Section con propuesta de valor institucional y modelo operativo -->
  <HeroNosotros />

  <!-- 02. Roster Interactivo del Equipo (Fighter Selection Stage) -->
  <TeamRosterSection />

  <!-- 03. Línea de Evolución y Madurez Técnica -->
  <EvolutionTimeline />

  <!-- 04. Filosofía de Trabajo y Principios Fundamentales -->
  <PhilosophySection />

  <!-- 04. Disciplinas y Capacidades Integradas del Equipo -->
  <TeamCapabilitiesGrid />

  <!-- 05. Presencia Internacional y Sedes Colombia ↔ USA -->
  <GlobalPresenceSection />

  <!-- 06. Bloque de Cierre Comercial con WhatsApp Nosotros y Formulario -->
  <NosotrosContactSection />
</BaseLayout>
