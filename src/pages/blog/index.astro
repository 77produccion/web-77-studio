---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '@/components/blog/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Blog de marketing, IA y automatización | 77 Studio';
const description =
  'Artículos sobre marketing con IA, automatización, desarrollo web, WhatsApp y captación de clientes para empresas en Colombia, LatAm y EE. UU.';

const serviceLinks = [
  { href: '/marketing/', label: 'Marketing con IA' },
  { href: '/web/', label: 'Desarrollo web' },
  { href: '/ia-automatizacion/', label: 'IA y automatización' },
  { href: '/productos-digitales/', label: 'Productos digitales' },
];
---

<BaseLayout title={title} description={description} whatsappContext="home" lang="es">
  <section class="pt-28 pb-8 md:pt-36 md:pb-12">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.18em] text-background-13/50">Blog</p>
      <h1 class="mt-3 max-w-3xl font-sora text-3xl font-semibold leading-[1.15] tracking-tight text-background-13 md:text-5xl">
        Ideas claras para vender y operar mejor
      </h1>
      <p class="mt-4 max-w-2xl font-inter-tight text-base leading-relaxed text-background-13/60 md:text-lg">
        Marketing, IA aplicada, automatización y seguimiento comercial — sin relleno y con criterio de negocio.
      </p>
      <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-2" aria-label="Servicios">
        {serviceLinks.map((link) => (
          <a href={link.href} class="font-inter-tight text-sm text-background-13/70 underline decoration-black/20 underline-offset-4 transition hover:text-opai-purple">
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="pb-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-5 sm:grid-cols-2 xl:grid-cols-3 md:px-8">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
