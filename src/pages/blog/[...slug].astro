---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { toPublicUrl, directoryPath } from '@/utils/seo';
import { readingMinutes } from '@/utils/reading-time';
import BlogCard from '@/components/blog/BlogCard.astro';
import ArticleCta from '@/components/blog/ArticleCta.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = Astro.site ?? new URL('https://www.77studio.co');
const canonical = toPublicUrl(site, directoryPath(`/blog/${post.id}/`));
const ogImage = post.data.heroImage;
const formattedDate = post.data.pubDate.toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.pubDate.toISOString();
const minutes = readingMinutes(post.body ?? post.data.description);

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => {
    const pillarScore = Number(b.data.pillar === post.data.pillar) - Number(a.data.pillar === post.data.pillar);
    return pillarScore || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  timeRequired: `PT${minutes}M`,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: 'https://www.77studio.co/',
  },
  publisher: {
    '@type': 'Organization',
    name: '77 Studio',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.77studio.co/img/77studio.png',
    },
  },
  image: toPublicUrl(site, post.data.heroImage),
  mainEntityOfPage: canonical,
  inLanguage: 'es-CO',
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`${post.data.title} | 77 Studio`}
  description={post.data.description}
  ogImage={ogImage}
  whatsappContext="home"
  lang="es"
  heroImage={post.data.heroImage}
>
  <script is:inline type="application/ld+json" set:html={articleLd} />

  <article class="pt-28 pb-20 md:pt-36 md:pb-28">
    <header class="mx-auto max-w-[720px] px-5">
      <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.18em] text-background-13/50">
        <a href="/blog/" class="transition hover:text-opai-purple">Blog</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>Artículo</span>
      </p>
      <h1 class="mt-4 font-sora text-[1.85rem] font-semibold leading-[1.18] tracking-tight text-background-13 text-balance md:text-[2.65rem]">
        {post.data.title}
      </h1>
      <p class="mt-5 font-inter-tight text-lg leading-relaxed text-background-13/70">
        {post.data.description}
      </p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-ibm-plex-mono text-[11px] uppercase tracking-[0.14em] text-background-13/50">
        <time datetime={isoDate}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min de lectura</span>
      </p>
    </header>

    <figure class="mx-auto mt-8 max-w-[720px] px-5 md:mt-10">
      <img
        src={post.data.heroImage}
        alt={post.data.heroImageAlt}
        width="1200"
        height="675"
        class="aspect-[16/9] w-full rounded-[20px] border border-stroke-2 object-cover shadow-sm"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="blog-prose prose mx-auto mt-10 max-w-[720px] px-5 md:mt-12">
      <Content />
    </div>

    <div class="mx-auto mt-12 max-w-[720px] px-5 md:mt-16">
      <ArticleCta title={post.data.title} />
    </div>

    {related.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl px-5 md:mt-20 md:px-8" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-sora text-2xl font-semibold tracking-tight text-background-13">
          También te puede servir
        </h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {related.map((entry) => (
            <BlogCard post={entry} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
