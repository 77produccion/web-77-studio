---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { toPublicUrl, directoryPath } from '@/utils/seo';
import { readingMinutes } from '@/utils/reading-time';
import BlogCard from '@/components/blog/BlogCard.astro';
import ArticleCta from '@/components/blog/ArticleCta.astro';
import '@/styles/blog.css';
import { CITIES, servicePath, type ServiceSlug } from '@/data/local-coverage';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = Astro.site ?? new URL('https://www.77studio.co');
const canonical = toPublicUrl(site, directoryPath(`/blog/${post.id}/`));
const ogImage = post.data.heroImage;
const formattedDate = post.data.pubDate.toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.pubDate.toISOString();
const minutes = readingMinutes(post.body ?? post.data.description);

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => {
    const pillarScore = Number(b.data.pillar === post.data.pillar) - Number(a.data.pillar === post.data.pillar);
    return pillarScore || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const serviceCatalog = {
  marketing: { href: '/marketing/', label: 'Marketing con IA' },
  web: { href: '/web/', label: 'Desarrollo web' },
  ia: { href: '/ia-automatizacion/', label: 'IA y automatización' },
  productos: { href: '/productos-digitales/', label: 'Productos digitales' },
} as const;

const pillarServices: Record<string, (keyof typeof serviceCatalog)[]> = {
  'automatizacion-marketing': ['marketing', 'ia'],
  'ia-agentes': ['ia'],
  'ads-captacion': ['marketing'],
  'web-conversion': ['web'],
  'crm-whatsapp': ['ia', 'marketing'],
  'productos-digitales': ['productos'],
  'contenido-ia': ['marketing', 'ia'],
  'noticias-ia': ['ia'],
};

const relatedServices = (pillarServices[post.data.pillar] ?? ['marketing']).map((key) => serviceCatalog[key]);

const localServiceByPillar: Record<string, ServiceSlug> = {
  'automatizacion-marketing': 'automatizacion',
  'ia-agentes': 'agentes-ia',
  'ads-captacion': 'marketing-digital',
  'web-conversion': 'paginas-web',
  'crm-whatsapp': 'agentes-ia',
  'productos-digitales': 'paginas-web',
  'contenido-ia': 'marketing-digital',
  'noticias-ia': 'agentes-ia',
};

const localService = localServiceByPillar[post.data.pillar] ?? 'marketing-digital';

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['Article', 'BlogPosting'],
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  timeRequired: `PT${minutes}M`,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Organization',
    '@id': 'https://www.77studio.co/#organization',
    name: post.data.author,
    url: 'https://www.77studio.co/',
  },
  publisher: { '@id': 'https://www.77studio.co/#organization' },
  image: toPublicUrl(site, post.data.heroImage),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
  },
  inLanguage: 'es-CO',
  isPartOf: {
    '@type': 'Blog',
    name: 'Blog de 77 Studio',
    url: 'https://www.77studio.co/blog/',
  },
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`${post.data.title} | 77 Studio`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  whatsappContext="home"
  lang="es"
  heroImage={post.data.heroImage}
  breadcrumbLabel={post.data.title}
>
  <script is:inline type="application/ld+json" set:html={articleLd} />

  <article class="pt-28 pb-20 md:pt-36 md:pb-28">
    <header class="mx-auto max-w-[720px] px-5">
      <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.18em] text-background-13/50">
        <a href="/blog/" class="transition hover:text-opai-purple">Blog</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>Artículo</span>
      </p>
      <h1 class="mt-4 font-sora text-[1.85rem] font-semibold leading-[1.18] tracking-tight text-background-13 text-balance md:text-[2.65rem]">
        {post.data.title}
      </h1>
      <p class="mt-5 font-inter-tight text-lg leading-relaxed text-background-13/70">
        {post.data.description}
      </p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-ibm-plex-mono text-[11px] uppercase tracking-[0.14em] text-background-13/50">
        <time datetime={isoDate}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min de lectura</span>
      </p>
    </header>

    <figure class="mx-auto mt-8 max-w-[720px] px-5 md:mt-10">
      <img
        src={post.data.heroImage}
        alt={post.data.heroImageAlt}
        width="1200"
        height="675"
        class="aspect-[16/9] w-full rounded-[20px] border border-stroke-2 object-cover shadow-sm"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="blog-prose prose mx-auto mt-10 max-w-[720px] px-5 md:mt-12">
      <Content />
    </div>

    <div class="mx-auto mt-12 max-w-[720px] px-5 md:mt-16">
      <ArticleCta title={post.data.title} />
      <nav class="mt-8" aria-label="Cobertura en el Eje Cafetero">
        <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.16em] text-background-13/50">También en el Eje Cafetero</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
          <li>
            <a href="/eje-cafetero/" class="font-inter-tight text-sm text-background-13/70 underline decoration-black/20 underline-offset-4 transition hover:text-opai-purple">Cobertura</a>
          </li>
          {CITIES.map((city) => (
            <li>
              <a href={servicePath(city.slug, localService)} class="font-inter-tight text-sm text-background-13/70 underline decoration-black/20 underline-offset-4 transition hover:text-opai-purple">
                {city.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav class="mt-8" aria-label="Servicios relacionados">
        <p class="font-ibm-plex-mono text-[11px] uppercase tracking-[0.16em] text-background-13/50">Servicios relacionados</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
          {relatedServices.map((service) => (
            <li>
              <a href={service.href} class="font-inter-tight text-sm text-background-13/70 underline decoration-black/20 underline-offset-4 transition hover:text-opai-purple">
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    {related.length > 0 && (
      <section class="mx-auto mt-16 max-w-6xl px-5 md:mt-20 md:px-8" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-sora text-2xl font-semibold tracking-tight text-background-13">
          También te puede servir
        </h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {related.map((entry) => (
            <BlogCard post={entry} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
