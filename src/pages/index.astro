---
// src/pages/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroHome from '@/components/home/HeroHome.astro';
import MetricsAndIntegrations from '@/components/home/MetricsAndIntegrations.astro';
import InternationalPresence from '@/components/home/InternationalPresence.astro';
import TeamRosterSection from '@/components/nosotros/TeamRosterSection.astro';
import PainPointsSection from '@/components/home/PainPointsSection.astro';
import EcosystemSection from '@/components/home/EcosystemSection.astro';
import PhilosophySection from '@/components/nosotros/PhilosophySection.astro';
import TestimonialsSection from '@/components/home/TestimonialsSection.astro';
import ProcessSection from '@/components/home/ProcessSection.astro';
import ContactSection from '@/components/home/ContactSection.astro';
import CoverageBand from '@/components/local/CoverageBand.astro';
import { getHomeTranslations } from '@/lib/i18n/pages/home';

const t = getHomeTranslations('es');
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  whatsappContext="home"
>
  <!-- 01. Hero Section con métricas en vivo y CTAs duales -->
  <HeroHome />

  <div class="home-below-fold">
  <!-- Metrics and Integrations Section (Light-Adapted) -->
  <MetricsAndIntegrations />

  <!-- 02. Presencia Internacional Colombia ↔ USA -->
  <InternationalPresence />

  <CoverageBand />

  <!-- Roster Interactivo del Equipo (Stage de Mosaicos) -->
  <TeamRosterSection />

  <!-- 03. El Reto: 5 Puntos de Dolor del Cliente -->
  <PainPointsSection />

  <!-- 04. Un Solo Partner Digital: Diagrama de Ecosistema Integrado -->
  <EcosystemSection />

  <!-- 05. Filosofía de Trabajo y Acordeón Interactivo -->
  <PhilosophySection />

  <!-- 06b. Prueba Social & Testimonios Reales -->
  <TestimonialsSection />

  <!-- 07. Proceso de Trabajo en 4 Pasos -->
  <ProcessSection />

  <!-- 08. Sección de Contacto Dual (WhatsApp + Formulario Comercial) -->
  <ContactSection />
  </div>
</BaseLayout>
