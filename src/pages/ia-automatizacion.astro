---
// src/pages/ia-automatizacion.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroIA from '@/components/ia/HeroIA.astro';
import IACapabilitiesGrid from '@/components/ia/IACapabilitiesGrid.astro';
import IAProblemSection from '@/components/ia/IAProblemSection.astro';
import AutomationVsAISection from '@/components/ia/AutomationVsAISection.astro';
import IADepartmentsSection from '@/components/ia/IADepartmentsSection.astro';
import IAContactSection from '@/components/ia/IAContactSection.astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';

const lang = 'es';
const t = getIaTranslations(lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  canonical="https://77.studio/ia-automatizacion"
  whatsappContext="ia"
  lang={lang}
>
  <!-- 01. Hero: IA y automatización para empresas -->
  <HeroIA lang={lang} />

  <!-- 02. Qué podemos hacer: Soluciones para hacer tu empresa más eficiente -->
  <IACapabilitiesGrid lang={lang} />

  <!-- 03. El problema: Muchas empresas tienen tecnología, pero siguen trabajando manualmente -->
  <IAProblemSection lang={lang} />

  <!-- 04. IA + Automatización: No todo necesita IA. No todo se resuelve con una automatización simple -->
  <AutomationVsAISection lang={lang} />

  <!-- 05. Dónde podemos aplicarlo: La IA puede entrar en diferentes áreas de tu empresa -->
  <IADepartmentsSection lang={lang} />

  <!-- 06. Cierre: ¿Qué proceso de tu empresa podría funcionar mejor? -->
  <IAContactSection lang={lang} />
</BaseLayout>
