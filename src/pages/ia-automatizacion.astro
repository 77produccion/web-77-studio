---
// src/pages/ia-automatizacion.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroIA from '@/components/ia/HeroIA.astro';
import CaseSpotlight from '@/components/casos/CaseSpotlight.astro';
import IACapabilitiesGrid from '@/components/ia/IACapabilitiesGrid.astro';
import IAProblemSection from '@/components/ia/IAProblemSection.astro';
import AutomationVsAISection from '@/components/ia/AutomationVsAISection.astro';
import IADepartmentsSection from '@/components/ia/IADepartmentsSection.astro';
import IAContactSection from '@/components/ia/IAContactSection.astro';
import CoverageBand from '@/components/local/CoverageBand.astro';
import { getIaTranslations } from '@/lib/i18n/pages/ia-automatizacion';

const lang = 'es';
const t = getIaTranslations(lang);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  whatsappContext="ia"
  lang={lang}
  heroImage="/img/ia-automatizacion-hero.webp"
>
  <!-- 01. Hero: IA y automatización para empresas -->
  <HeroIA lang={lang} />

  <!-- 02. Qué podemos hacer: Soluciones para hacer tu empresa más eficiente -->
  <IACapabilitiesGrid lang={lang} />

  <!-- 03. El problema: Muchas empresas tienen tecnología, pero siguen trabajando manualmente -->
  <IAProblemSection lang={lang} />

  <CaseSpotlight variant="service" />

  <!-- 04. IA + Automatización: No todo necesita IA. No todo se resuelve con una automatización simple -->
  <AutomationVsAISection lang={lang} />

  <!-- 05. Dónde podemos aplicarlo: La IA puede entrar en diferentes áreas de tu empresa -->
  <IADepartmentsSection lang={lang} />

  <section class="border-t border-black/5 bg-white" aria-labelledby="agentes-whatsapp-colombia">
    <div class="mx-auto max-w-[1290px] px-5 py-14 sm:px-6 sm:py-16">
      <p class="font-ibm-plex-mono text-xs font-medium uppercase tracking-[0.18em] text-opai-purple">WhatsApp</p>
      <h2 id="agentes-whatsapp-colombia" class="mt-3 max-w-3xl font-sora text-3xl font-semibold tracking-tight text-background-13 sm:text-4xl">
        Agentes de IA para WhatsApp en Colombia
      </h2>
      <p class="mt-4 max-w-2xl font-inter-tight text-base leading-relaxed text-background-13/70">
        Implementamos agentes de IA y automatización de WhatsApp para empresas en Colombia: atención 24/7, calificación de leads, agendamiento y CRM. Sede en Armenia.
      </p>
      <p class="mt-5 font-inter-tight text-sm">
        <a href="/agentes-ia-whatsapp-colombia/" class="text-background-13/80 underline decoration-black/20 underline-offset-4 hover:text-opai-purple">
          Ver agentes de IA para WhatsApp en Colombia
        </a>
      </p>
    </div>
  </section>

  <CoverageBand />

  <!-- 06. Cierre: ¿Qué proceso de tu empresa podría funcionar mejor? -->
  <IAContactSection lang={lang} />
</BaseLayout>
